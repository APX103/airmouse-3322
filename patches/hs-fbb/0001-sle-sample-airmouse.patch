+    uapi_pin_set_mode(pin, PIN_MODE_0);
+    (void)uapi_gpio_set_dir(pin, GPIO_DIRECTION_INPUT);
+    for (uint32_t i = 0; i < 3; i++) {
+        (void)uapi_pin_set_pull(pin, pulls[i]);
+        osal_msleep(20); // 等电平稳定
+        for (uint32_t n = 0; n < AIM_INPUT_DIAG_N; n++) {
+            highs[i] += aim_pin_level(pin);
+            osal_msleep(1);
+        }
+    }
