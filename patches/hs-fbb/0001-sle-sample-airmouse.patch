+#define AIM_BTN_R_PIN S_AGPIO12   // RX4（J1902 第 7 脚）
+#define AIM_BTN_M_PIN S_AGPIO17   // 板上自定义按键 SW2102（AIO17_KEY），接地式，零接线
+
+static uint8_t g_aim_btn_open[3] = {0, 0, 0}; // 左/右/置中键脚的开路电平
+
+static void aim_btn_init(void)
+{
+    aim_input_config(AIM_BTN_L_PIN);
+    aim_input_config(AIM_BTN_R_PIN);
+    aim_input_config(AIM_BTN_M_PIN);
+    osal_msleep(5); // 等配置稳定
