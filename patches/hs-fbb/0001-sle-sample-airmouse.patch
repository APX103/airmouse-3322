new file mode 100644
index 000000000..b618bbb86
--- /dev/null
+++ b/samples/native_samples/sle/ekf7.h
@@ -0,0 +1,160 @@
+/*
+ * ekf7.h — 七状态(四元数+速度)全量 EKF 姿态解算，C99 移植
+ *
+ * 与 Python 参考实现（../ekf7/ 包）逐行对应；黑盒差分验证见 c/README.md。
+ * 无动态分配、无外部依赖，可直接并入嵌入式工程（改 ekf7_real 为 float 即可，
+ * 但需重新做差分验证评估精度损失）。
+ *
+ * 快速上手：
+ *   ekf7_pipeline pipe;
+ *   ekf7_pipeline_init(&pipe, 200.0, 1, 9);        // fs, work_mode, amode(6/9)
+ *   ekf7_output out;
+ *   ekf7_pipeline_calculate(&pipe, acc, gyro, mag, &out);  // 每拍一次
+ *   // out.quat / out.euler_rad / out.vel / out.pos / out.motionless
+ */
+#ifndef EKF7_H
+#define EKF7_H
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef double ekf7_real; /* 固件单精度 FPU 场景可改为 float（需重验差分） */
+
+/* ---------------- 参数（默认 = 200Hz 档整定，见 ../README.md 参数表） ---------- */
+typedef struct {
+    double fs;                    /* 采样率 Hz */
+    int    ipack_mean;            /* 打包均值 */
+    int    work_mode;             /* 0/1/2 位置积分手感档位 */
+    double gyro_filt_k, acc_filt_k; /* 输入一阶低通系数 */
+    double k_bias;
+    int    amode;                 /* 6=六轴(无磁) 9=九轴(磁航向融合) */
+    double g0;                    /* 重力常量 */
+    double auto_cal_gyro_max_min; /* 自标定静止陀螺峰峰值阈 */
+    double auto_cal_acc_max_min;  /* 自标定静止加计峰峰值阈 */
+    double body_vel_gate;         /* ZUPT 卡方门限基数 */
+    int    mag_fuse_method;       /* 2=启用磁航向融合 */
+    double mag_time_delay;
+    double mag_hdg_error;         /* 磁航向测量噪声 */
+    double mag_hdg_gate;          /* 磁航向卡方门限 */
+    double mag_decl_deg;          /* 磁偏角（度） */
+    double ang_rate_bias_k;       /* 陀螺零偏指数平滑系数 */
+    double ang_rate_noise;        /* 过程噪声: 角度增量 (rad) */
+    double accel_noise;           /* 过程噪声: 速度增量 (m/s) */
+    double vel_err_ne, vel_err_d; /* 初始协方差: 速度 */
+    double quat_err;              /* 初始协方差: 四元数 */
+} ekf7_params;
+
+ekf7_params ekf7_params_default(void);
+
+/* ---------------- 三级静止检测器（0运动/1低角速率/2仅yaw静止/4完全静止） -------- */
+typedef struct {
+    double imu_sum_time_abs;
+    double acc_raw_max_abs[3], acc_raw_min_abs[3];
+    double gyro_raw_max_abs[3], gyro_raw_min_abs[3];
+    double yaw_sum_time, yaw_max, yaw_min;
+    double gyro_ml_sum_time;
+    int    motionless_flag_out;
+} ekf7_motion_state;
+
+int ekf7_motion_detect(const double acc_in[3], const double gyro_in[3],
+                       ekf7_motion_state *ml, const ekf7_params *p, double dt);
+
+/* ---------------- 静止自标定（安装矩阵 + 陀螺零偏） ---------------- */
+typedef struct {
+    double run_flag, ml_error_flag, imu_sum_time_abs;
+    double acc_raw_max_abs[3], acc_raw_min_abs[3];
+    double gyro_raw_max_abs[3], gyro_raw_min_abs[3];
+    double motionless_cnt;
+    double acc_in_sum1[3], gyro_in_sum1[3];
+    double imu_in_cnt1;
+} ekf7_autocal_state;
+
+typedef struct {
+    double gyro_bias[3];
+    double imu_r[9];   /* 行主序 3x3 安装矩阵 */
+    bool   completed;
+} ekf7_autocal_result;
+
+void ekf7_autocal_run(const double acc_in[3], const double gyro_in[3],
+                      ekf7_autocal_state *st, const ekf7_params *p, double dt,
+                      ekf7_autocal_result *out);
+
+/* ---------------- 主滤波器（NavigationFilter） ---------------- */
+typedef struct {
+    ekf7_params prm;               /* 参数副本 */
+    double q[4];                  /* 姿态四元数 wxyz */
+    double v[3];                  /* ENU 导航系速度 */
+    double p[7][7];               /* 协方差 */
+    double flag_in, init_max_time;
+    double gyro_old[3], acc_sum[3], gyro_sum[3], mag_sum[3];
+    double del_ang_cov[3], dt_cov, flag_div;
+    double motionless_cnt, mag_run_time, gyro0_init_flag;
+    double del_vel_cov[3], acc_in_k, dt_run_time;
+    double gyro_in_bias[3], gyro_in_sum1[3], gyro_in_cnt1;
+    double gyro_in_sum2[3], gyro_in_cnt2;
+    double del_ang_bias[3], position[3], mag_in_old[3];
+} ekf7_filter;
+
+void   ekf7_filter_init(ekf7_filter *f, const ekf7_params *prm);
+void   ekf7_filter_reset(ekf7_filter *f);
+void   ekf7_filter_step(ekf7_filter *f, const double acc_in[3],
+                        const double gyro_in[3], const double mag_in[3],
+                        double dt_imu, int motionless_flag);
+void   ekf7_filter_euler(const ekf7_filter *f, double rpy_rad[3]);
+
+/* ---------------- 端到端管线（低通 → 自标定 → 检测 → 滤波） ---------------- */
+typedef struct {
+    ekf7_params     prm;
+    double          dt;
+    ekf7_filter     filt;
+    ekf7_motion_state  ml;
+    ekf7_autocal_state cal;
+    double acc_filt[3], gyro_filt[3];
+    bool   filt_init;
+    double rotm_install[9];       /* 行主序 3x3 */
+    double gyro_bias[3];
+    bool   enable_autocal;
+    int    icount;
+} ekf7_pipeline;
+
+typedef struct {
+    double quat[4];
+    double euler_rad[3];
+    double vel[3];
+    double pos[3];
+    int    motionless;
+} ekf7_output;
+
+void ekf7_pipeline_init(ekf7_pipeline *pl, double fs, int work_mode, int amode);
+/* mag 可传 NULL（六轴模式） */
+void ekf7_pipeline_calculate(ekf7_pipeline *pl, const double acc_raw[3],
+                             const double gyro_raw[3], const double mag_raw[3],
+                             ekf7_output *out);
+
+/* ---------------- 底层数学（公开便于单元测试/复用） ---------------- */
+void   ekf7_quat_multiply(const double a[4], const double b[4], double out[4]);
+void   ekf7_quat_normalized(const double q[4], double out[4]);
+void   ekf7_quat_to_dcm(const double q[4], double r[9]);            /* 体->导航 */
+void   ekf7_quat_from_rv(const double rv[3], double q[4]);          /* 旋转向量 */
+void   ekf7_quat_from_euler(double phi, double theta, double psi, double q[4]);
+void   ekf7_quat_to_euler(const double q[4], double rpy[3]);
+double ekf7_wrap_pi(double angle);
+void   ekf7_kfilter_inplace(double *prev, const double *x, double k, int n);
+
+/* 雅可比（供研究/测试直接调用） */
+void ekf7_calc_f7(double dax, double day, double daz,
+                  double dvx, double dvy, double dvz,
+                  double q0, double q1, double q2, double q3, double f[7][7]);
+void ekf7_calc_q7(double dax_var, double day_var, double daz_var,
+                  double dvx_var, double dvy_var, double dvz_var,
+                  double q0, double q1, double q2, double q3, double q[7][7]);
+void ekf7_calc_h_hdgc(double mx, double my, double mz,
+                      double q0, double q1, double q2, double q3, double h[7]);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* EKF7_H */
diff --git a/samples/native_samples/sle/ekf7_filter.c b/samples/native_samples/sle/ekf7_filter.c
new file mode 100644
index 000000000..83ee411f1
--- /dev/null
+++ b/samples/native_samples/sle/ekf7_filter.c
@@ -0,0 +1,562 @@
+/* ekf7_filter.c — 对准/预测/观测与主滤波循环
+ * （对应 ../ekf7/{alignment,prediction,observations,navigation_filter}.py） */
+#include <math.h>
+#include <string.h>
+
+#include "ekf7.h"
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+ekf7_params ekf7_params_default(void)
+{
+    ekf7_params p;
+    p.fs = 200.0;
+    p.ipack_mean = 1;
+    p.work_mode = 0;
+    p.gyro_filt_k = 0.5; /* AirMouse 2026-10-14: 0.1→0.5，时间常数 100ms→20ms，实测滞后主源 */
+    p.acc_filt_k = 0.3;
+    p.k_bias = 0.1;
+    p.amode = 6;
+    p.g0 = 9.795502520545487;
+    p.auto_cal_gyro_max_min = M_PI / 900.0;
+    p.auto_cal_acc_max_min = 0.05;
+    p.body_vel_gate = 10.0;
+    p.mag_fuse_method = 2;
+    p.mag_time_delay = 0.0;
+    p.mag_hdg_error = 0.1745;
+    p.mag_hdg_gate = 5.0;
+    p.mag_decl_deg = 0.0;
+    p.ang_rate_bias_k = 0.04;
+    p.ang_rate_noise = 0.01;
+    p.accel_noise = 0.35;
+    p.vel_err_ne = 5.0;
+    p.vel_err_d = 1.0;
+    p.quat_err = 0.1;
+    return p;
+}
+
+/* ---------------- 对准（alignment.py） ---------------- */
+
+static void align_tilt(const double init_accel[3], double q_out[4])
+{
+    const double ax = init_accel[0], ay = init_accel[1], az = init_accel[2];
+    const double norm = sqrt(ax * ax + ay * ay + az * az);
+    if (norm > 5.0 && norm < 14.0) {
+        const double horiz = sqrt(ax * ax + ay * ay);
+        const double tilt = atan2(horiz, az);
+        if (tilt > 0.001) {
+            /* axis = accel × ẑ */
+            const double c[3] = { ay * 1.0 - az * 0.0, az * 0.0 - ax * 1.0, ax * 0.0 - ay * 0.0 };
+            const double cn = sqrt(c[0] * c[0] + c[1] * c[1] + c[2] * c[2]);
+            if (cn > 1e-12) {
+                const double s = sin(0.5 * tilt);
+                q_out[0] = cos(0.5 * tilt);
+                q_out[1] = (c[0] / cn) * s;
+                q_out[2] = (c[1] / cn) * s;
+                q_out[3] = (c[2] / cn) * s;
+                return;
+            }
+        }
+    }
+    /* 保持原值 */
+    (void)q_out;
+}
+
+static void align_heading(const double q_in[4], const double mag[3],
+                          double declination, double q_out[4])
+{
+    double e[3];
+    ekf7_quat_to_euler(q_in, e);
+    e[2] = 0.0;
+    double q_level[4], r[9], mnav[3];
+    ekf7_quat_from_euler(e[0], e[1], e[2], q_level);
+    ekf7_quat_to_dcm(q_level, r);
+    for (int i = 0; i < 3; i++)
+        mnav[i] = r[3 * i] * mag[0] + r[3 * i + 1] * mag[1] + r[3 * i + 2] * mag[2];
+    e[2] = declination + atan2(mnav[0], mnav[1]);
+    ekf7_quat_from_euler(e[0], e[1], e[2], q_out);
+}
+
+static void init_states(const double acc_in[3], const double gyro_in[3],
+                        const double mag_in[3], const ekf7_params *prm, double q_out[4])
+{
+    double q[4] = { 1.0, 0.0, 0.0, 0.0 };
+    if (fabs(gyro_in[0]) < 0.05 && fabs(gyro_in[1]) < 0.05 && fabs(gyro_in[2]) < 0.05)
+        align_tilt(acc_in, q);
+    if (sqrt(mag_in[0] * mag_in[0] + mag_in[1] * mag_in[1] + mag_in[2] * mag_in[2]) > 0.0) {
+        const double decl = prm->mag_decl_deg * (M_PI / 180.0);
+        double qh[4];
+        align_heading(q, mag_in, decl, qh);
+        memcpy(q, qh, sizeof q);
+    }
+    memcpy(q_out, q, sizeof q);
+}
+
+static void init_covariance(const ekf7_params *prm, int amode, double p[7][7])
+{
+    double qd[4];
+    const double one = prm->quat_err;
+    qd[0] = one; qd[1] = one; qd[2] = one;
+    qd[3] = (amode != 6) ? one : 0.0; /* 六轴：q3(yaw) 误差置 0 */
+    const double vd[3] = { prm->vel_err_ne, prm->vel_err_ne, prm->vel_err_d };
+    memset(p, 0, sizeof(double) * 49);
+    for (int i = 0; i < 4; i++) p[i][i] = qd[i] * qd[i];
+    for (int j = 0; j < 3; j++) p[4 + j][4 + j] = vd[j] * vd[j];
+}
+
+/* ---------------- 预测（prediction.py） ---------------- */
+
+static void state_predict(const double q_in[4], const double v_in[3],
+                          const double del_ang[3], const double del_vel[3],
+                          double dt, const double del_ang_bias[3],
+                          int out_run_pos_flag, const double pos_in[3],
+                          double gravity,
+                          double q_out[4], double v_out[3], double pos_out[3],
+                          double corr_ang[3], double corr_vel[3])
+{
+    double dang[3], dq[4], q_tmp[4], r[9], gv[3], v_new[3];
+    for (int i = 0; i < 3; i++)
+        dang[i] = del_ang[i] - del_ang_bias[i];
+    ekf7_quat_from_rv(dang, dq);
+    ekf7_quat_multiply(q_in, dq, q_tmp);
+    ekf7_quat_normalized(q_tmp, q_out);
+    ekf7_quat_to_dcm(q_out, r);
+    for (int i = 0; i < 3; i++) {
+        gv[i] = r[3 * i] * del_vel[0] + r[3 * i + 1] * del_vel[1] + r[3 * i + 2] * del_vel[2];
+        if (i == 2) gv[i] -= gravity * dt;
+        v_new[i] = v_in[i] + gv[i];
+    }
+    for (int i = 0; i < 3; i++) {
+        pos_out[i] = pos_in[i];
+        if (out_run_pos_flag > 0)
+            pos_out[i] += 0.5 * dt * (v_in[i] + v_new[i]);
+        v_out[i] = v_new[i];
+        corr_ang[i] = dang[i];
+        corr_vel[i] = del_vel[i];
+    }
+}
+
+static void covariance_predict(double p[7][7], const double delta_angle[3],
+                               const double delta_velocity[3], const double q[4],
+                               double dt, int motionless_flag, int amode,
+                               const ekf7_params *prm)
+{
+    const double n_var = dt * prm->ang_rate_noise * (dt * prm->ang_rate_noise);
+    double dax_var = n_var, day_var = n_var, daz_var = n_var;
+    const double n2_var = dt * prm->accel_noise * (dt * prm->accel_noise);
+    double dvx_var = n2_var, dvy_var = n2_var, dvz_var = n2_var;
+    double dvx = delta_velocity[0], dvy = delta_velocity[1], dvz = delta_velocity[2];
+    double dax = delta_angle[0], day = delta_angle[1], daz = delta_angle[2];
+    double f[7][7], qm[7][7], tmp[7][7];
+
+    if (amode == 6)
+        daz_var = 0.0;
+    if (motionless_flag > 3) {
+        dax = 0.0; day = 0.0; daz = 0.0;
+    }
+    ekf7_calc_f7(dax, day, daz, dvx, dvy, dvz, q[0], q[1], q[2], q[3], f);
+    ekf7_calc_q7(dax_var, day_var, daz_var, dvx_var, dvy_var, dvz_var,
+                 q[0], q[1], q[2], q[3], qm);
+    /* tmp = f * p * f^T + qm */
+    for (int i = 0; i < 7; i++)
+        for (int j = 0; j < 7; j++) {
+            double s = 0.0;
+            for (int k = 0; k < 7; k++) s += f[i][k] * p[k][j];
+            tmp[i][j] = s;
+        }
+    for (int i = 0; i < 7; i++)
+        for (int j = 0; j < 7; j++) {
+            double s = 0.0;
+            for (int k = 0; k < 7; k++) s += tmp[i][k] * f[j][k];
+            p[i][j] = s + qm[i][j];
+        }
+    for (int i = 0; i < 7; i++)
+        for (int j = i + 1; j < 7; j++) {
+            const double s = 0.5 * (p[i][j] + p[j][i]);
+            p[i][j] = s; p[j][i] = s;
+        }
+    for (int i = 0; i < 7; i++)
+        if (p[i][i] < 0.0) p[i][i] = 0.0;
+}
+
+/* ---------------- 观测（observations.py） ---------------- */
+
+/* 3x3 逆（伴随式），供 ZUPT 的 inv(S) */
+static void inv3(const double a[3][3], double out[3][3])
+{
+    const double c00 = a[1][1] * a[2][2] - a[1][2] * a[2][1];
+    const double c01 = a[1][2] * a[2][0] - a[1][0] * a[2][2];
+    const double c02 = a[1][0] * a[2][1] - a[1][1] * a[2][0];
+    const double det = a[0][0] * c00 + a[0][1] * c01 + a[0][2] * c02;
+    const double inv = 1.0 / det;
+    out[0][0] = c00 * inv;
+    out[0][1] = (a[0][2] * a[2][1] - a[0][1] * a[2][2]) * inv;
+    out[0][2] = (a[0][1] * a[1][2] - a[0][2] * a[1][1]) * inv;
+    out[1][0] = c01 * inv;
+    out[1][1] = (a[0][0] * a[2][2] - a[0][2] * a[2][0]) * inv;
+    out[1][2] = (a[0][2] * a[1][0] - a[0][0] * a[1][2]) * inv;
+    out[2][0] = c02 * inv;
+    out[2][1] = (a[0][1] * a[2][0] - a[0][0] * a[2][1]) * inv;
+    out[2][2] = (a[0][0] * a[1][1] - a[0][1] * a[1][0]) * inv;
+}
+
+/* H = [0_3x4 | I_3] 的结构被显式利用，避免通用矩阵乘 */
+static void velocity_observation_fuse(double q_in[4], double v_in[3], double p[7][7],
+                                      double obs_var, double gate_size,
+                                      double q_out[4], double v_out[3])
+{
+    double s[3][3];
+    for (int j = 0; j < 3; j++)
+        for (int k = 0; k < 3; k++)
+            s[j][k] = p[4 + j][4 + k] + ((j == k) ? obs_var : 0.0);
+    for (int i = 0; i < 3; i++) {
+        if (v_in[i] * v_in[i] / (gate_size * gate_size * s[i][i]) > 1.0) {
+            /* 拒绝本次观测：原样返回 */
+            memcpy(q_out, q_in, sizeof(double) * 4);
+            memcpy(v_out, v_in, sizeof(double) * 3);
+            return;
+        }
+    }
+    double sinv[3][3];
+    inv3(s, sinv);
+    /* K = P[:, 4:7] * inv(S)  (7x3) */
+    double k[7][3];
+    for (int i = 0; i < 7; i++)
+        for (int j = 0; j < 3; j++) {
+            double acc = 0.0;
+            for (int m2 = 0; m2 < 3; m2++)
+                acc += p[i][4 + m2] * sinv[m2][j];
+            k[i][j] = acc;
+        }
+    double x[7];
+    memcpy(x, q_in, sizeof(double) * 4);
+    memcpy(x + 4, v_in, sizeof(double) * 3);
+    for (int i = 0; i < 7; i++) {
+        double d = 0.0;
+        for (int j = 0; j < 3; j++) d += k[i][j] * v_in[j];
+        x[i] -= d;
+    }
+    memcpy(q_out, x, sizeof(double) * 4);
+    ekf7_quat_normalized(q_out, q_out);
+    memcpy(v_out, x + 4, sizeof(double) * 3);
+    /* P -= K * P[4:7, :] */
+    for (int i = 0; i < 7; i++)
+        for (int c = 0; c < 7; c++) {
+            double d = 0.0;
+            for (int j = 0; j < 3; j++) d += k[i][j] * p[4 + j][c];
+            p[i][c] -= d;
+        }
+    for (int i = 0; i < 7; i++)
+        for (int j = i + 1; j < 7; j++) {
+            const double m2 = 0.5 * (p[i][j] + p[j][i]);
+            p[i][j] = m2; p[j][i] = m2;
+        }
+    for (int i = 0; i < 7; i++)
+        if (p[i][i] < 0.0) p[i][i] = 0.0;
+}
+
+static void mag_heading_observation_fuse(double q_in[4], double v_in[3], double p[7][7],
+                                         const double mag[3], double meas_dec,
+                                         double innov_gate, double r_mag,
+                                         double q_out[4], double v_out[3])
+{
+    double r[9], mnav[3], h[7], ph[7], k[7];
+    ekf7_quat_to_dcm(q_in, r);
+    for (int i = 0; i < 3; i++)
+        mnav[i] = r[3 * i] * mag[0] + r[3 * i + 1] * mag[1] + r[3 * i + 2] * mag[2];
+    double nu = atan2(mnav[0], mnav[1]) - meas_dec;
+    if (nu > M_PI) nu -= 2.0 * M_PI;
+    else if (nu < -M_PI) nu += 2.0 * M_PI;
+    ekf7_calc_h_hdgc(mag[0], mag[1], mag[2], q_in[0], q_in[1], q_in[2], q_in[3], h);
+    for (int j = 0; j < 7; j++) {
+        double acc = 0.0;
+        for (int i = 0; i < 7; i++) acc += h[i] * p[i][j];
+        ph[j] = acc;
+    }
+    double s = 0.0;
+    for (int i = 0; i < 7; i++) s += ph[i] * h[i];
+    s += r_mag;
+    if (nu * nu / (innov_gate * innov_gate * s) > 1.0) {
+        memcpy(q_out, q_in, sizeof(double) * 4);
+        memcpy(v_out, v_in, sizeof(double) * 3);
+        return;
+    }
+    for (int i = 0; i < 7; i++) {
+        double acc = 0.0;
+        for (int j = 0; j < 7; j++) acc += p[i][j] * h[j];
+        k[i] = acc / s;
+    }
+    double x[7];
+    memcpy(x, q_in, sizeof(double) * 4);
+    memcpy(x + 4, v_in, sizeof(double) * 3);
+    for (int i = 0; i < 7; i++) x[i] -= k[i] * nu;
+    memcpy(q_out, x, sizeof(double) * 4);
+    ekf7_quat_normalized(q_out, q_out);
+    memcpy(v_out, x + 4, sizeof(double) * 3);
+    for (int i = 0; i < 7; i++)
+        for (int c = 0; c < 7; c++)
+            p[i][c] -= k[i] * ph[c];
+    for (int i = 0; i < 7; i++)
+        for (int j = i + 1; j < 7; j++) {
+            const double m2 = 0.5 * (p[i][j] + p[j][i]);
+            p[i][j] = m2; p[j][i] = m2;
+        }
+    for (int i = 0; i < 7; i++)
+        if (p[i][i] < 0.0) p[i][i] = 0.0;
+}
+
+/* ---------------- 主滤波循环（navigation_filter.py） ---------------- */
+
+void ekf7_filter_init(ekf7_filter *f, const ekf7_params *prm)
+{
+    f->prm = *prm;
+    ekf7_filter_reset(f);
+}
+
+void ekf7_filter_reset(ekf7_filter *f)
+{
+    ekf7_params prm = f->prm; /* 参数不在 reset 范围内（对应 Python 的独立 param 对象） */
+    memset(f, 0, sizeof *f);
+    f->prm = prm;
+    f->q[0] = 1.0;
+    /* 其余字段按 C# 语义默认全 0（含 min/max 锚点） */
+}
+
+void ekf7_filter_euler(const ekf7_filter *f, double rpy_rad[3])
+{
+    ekf7_quat_to_euler(f->q, rpy_rad);
+}
+
+void ekf7_filter_step(ekf7_filter *f, const double acc_in[3],
+                      const double gyro_in[3], const double mag_in[3],
+                      double dt_imu, int motionless_flag)
+{
+    const ekf7_params *prm = &f->prm;
+    const int n = (int)(prm->fs * (double)prm->ipack_mean);
+    const double gyro_norm = sqrt(gyro_in[0] * gyro_in[0] + gyro_in[1] * gyro_in[1]
+                                  + gyro_in[2] * gyro_in[2]);
+    double mag[3];
+    if (motionless_flag > 3) {
+        memcpy(mag, f->mag_in_old, sizeof mag);
+    } else {
+        memcpy(mag, mag_in, sizeof mag);
+        memcpy(f->mag_in_old, mag_in, sizeof mag);
+    }
+    const double n3 = (double)(n * 3);
+
+    if (f->init_max_time < 0.1) {
+        /* 阶段 0：强制单位四元数 */
+        f->init_max_time += dt_imu;
+        f->q[0] = 1.0;
+    } else if (f->init_max_time < 3.0) {
+        /* 阶段 1：静置均值累计 */
+        f->init_max_time += dt_imu;
+        if (fabs(f->flag_in - 0.0) < 1e-7) {
+            memcpy(f->acc_sum, acc_in, sizeof f->acc_sum);
+            memcpy(f->gyro_sum, gyro_in, sizeof f->gyro_sum);
+            memcpy(f->mag_sum, mag, sizeof f->mag_sum);
+            f->flag_in += 1.0;
+        } else if (f->flag_in < n3) {
+            for (int i = 0; i < 3; i++) {
+                f->acc_sum[i] += acc_in[i];
+                f->gyro_sum[i] += gyro_in[i];
+                f->mag_sum[i] += mag[i];
+            }
+            if (fabs(gyro_in[0] - f->gyro_old[0]) < 0.02
+                && fabs(gyro_in[1] - f->gyro_old[1]) < 0.02
+                && fabs(gyro_in[2] - f->gyro_old[2]) < 0.02)
+                f->flag_in += 1.0;
+            else
+                f->flag_in = 0.0;
+        }
+        if (f->flag_in >= (double)n)
+            f->init_max_time = 3.0;
+    } else if (f->init_max_time < 4.0) {
+        /* 阶段 2：粗对准 */
+        double acc_mean[3], gyro_mean[3], mag_mean[3];
+        f->init_max_time = 4.0;
+        if (f->flag_in >= (double)n) {
+            for (int i = 0; i < 3; i++) {
+                acc_mean[i] = f->acc_sum[i] / f->flag_in;
+                gyro_mean[i] = f->gyro_sum[i] / f->flag_in;
+                mag_mean[i] = f->mag_sum[i] / f->flag_in;
+            }
+            const double an = sqrt(acc_mean[0] * acc_mean[0] + acc_mean[1] * acc_mean[1]
+                                   + acc_mean[2] * acc_mean[2]);
+            f->acc_in_k = prm->g0 / an;
+            for (int i = 0; i < 3; i++) acc_mean[i] *= f->acc_in_k;
+        } else {
+            acc_mean[0] = 0.0; acc_mean[1] = 0.0; acc_mean[2] = prm->g0;
+            gyro_mean[0] = gyro_mean[1] = gyro_mean[2] = 1.0;
+            memcpy(mag_mean, mag, sizeof mag_mean);
+            f->acc_in_k = 1.0;
+        }
+        memset(f->del_ang_cov, 0, sizeof f->del_ang_cov);
+        f->dt_cov = 0.0;
+        f->flag_div = 0.0;
+        init_states(acc_mean, gyro_mean, mag_mean, prm, f->q);
+        init_covariance(prm, prm->amode, f->p);
+        if (fabs(gyro_mean[0]) < 0.05 && fabs(gyro_mean[1]) < 0.05
+            && fabs(gyro_mean[2]) < 0.05) {
+            memcpy(f->gyro_in_bias, gyro_mean, sizeof f->gyro_in_bias);
+        } else {
+            gyro_mean[0] = gyro_mean[1] = gyro_mean[2] = 0.0;
+            memcpy(f->gyro_in_bias, gyro_mean, sizeof f->gyro_in_bias);
+        }
+        for (int i = 0; i < 3; i++)
+            f->del_ang_bias[i] = gyro_mean[i] * dt_imu;
+    } else {
+        /* 阶段 3：正式滤波 */
+        double del_ang[3], del_vel[3];
+        for (int i = 0; i < 3; i++) {
+            del_ang[i] = gyro_in[i] * dt_imu;
+            del_vel[i] = f->acc_in_k * acc_in[i] * dt_imu;
+        }
+        f->mag_run_time = f->mag_run_time + dt_imu;
+        if (f->mag_run_time > 100.0) f->mag_run_time = 100.0;
+
+        if (fabs(f->gyro0_init_flag - 0.0) < 1e-7) {
+            f->gyro0_init_flag =
+                (fabs(f->del_ang_bias[0]) + fabs(f->del_ang_bias[1])
+                 + fabs(f->del_ang_bias[2]) < 1e-7) ? 1.0 : 2.0;
+        }
+        if (f->gyro0_init_flag < 2.0 && motionless_flag > 3) {
+            memcpy(f->del_ang_bias, del_ang, sizeof f->del_ang_bias);
+            f->gyro0_init_flag = 2.0;
+        }
+
+        if (motionless_flag == 4) {
+            f->motionless_cnt += 1.0;
+            const double n4 = (double)n * 0.23;
+            if (f->motionless_cnt < n4 * 1.0) {
+                memset(f->gyro_in_sum1, 0, sizeof f->gyro_in_sum1);
+                f->gyro_in_cnt1 = 0.0;
+                memset(f->gyro_in_sum2, 0, sizeof f->gyro_in_sum2);
+                f->gyro_in_cnt2 = 0.0;
+            } else if (f->motionless_cnt < n4 * 2.0) {
+                for (int i = 0; i < 3; i++) f->gyro_in_sum1[i] += gyro_in[i];
+                f->gyro_in_cnt1 += 1.0;
+            } else if (f->motionless_cnt < n4 * 3.0) {
+                for (int i = 0; i < 3; i++) f->gyro_in_sum2[i] += gyro_in[i];
+                f->gyro_in_cnt2 += 1.0;
+            } else {
+                double mean1[3];
+                for (int i = 0; i < 3; i++) mean1[i] = f->gyro_in_sum1[i] / f->gyro_in_cnt1;
+                if (fabs(f->gyro_in_bias[0]) + fabs(f->gyro_in_bias[1])
+                    + fabs(f->gyro_in_bias[2]) < 1e-5)
+                    memcpy(f->gyro_in_bias, mean1, sizeof f->gyro_in_bias);
+                const double kb = prm->ang_rate_bias_k;
+                for (int i = 0; i < 3; i++)
+                    f->gyro_in_bias[i] = f->gyro_in_bias[i] * (1.0 - kb) + mean1[i] * kb;
+                for (int i = 0; i < 3; i++)
+                    f->del_ang_bias[i] = f->gyro_in_bias[i] * dt_imu;
+                memcpy(f->gyro_in_sum1, f->gyro_in_sum2, sizeof f->gyro_in_sum1);
+                f->gyro_in_cnt1 = f->gyro_in_cnt2;
+                memset(f->gyro_in_sum2, 0, sizeof f->gyro_in_sum2);
+                f->gyro_in_cnt2 = 0.0;
+                f->motionless_cnt = n4 * 2.0;
+            }
+        } else {
+            f->motionless_cnt = 0.0;
+        }
+
+        if (motionless_flag > 3)
+            memcpy(del_ang, f->del_ang_bias, sizeof del_ang);
+
+        int out_run_pos_flag = 0;
+        if (prm->work_mode == 1) {
+            if (gyro_norm > 50.0 / 573.0)
+                out_run_pos_flag = 1;
+        } else if (prm->work_mode == 2 && motionless_flag < 1) {
+            out_run_pos_flag = 1;
+        }
+
+        double corr_ang[3], corr_vel[3];
+        state_predict(f->q, f->v, del_ang, del_vel, dt_imu, f->del_ang_bias,
+                      out_run_pos_flag, f->position, prm->g0,
+                      f->q, f->v, f->position, corr_ang, corr_vel);
+        f->dt_cov += dt_imu;
+        for (int i = 0; i < 3; i++) {
+            f->del_ang_cov[i] += corr_ang[i];
+            f->del_vel_cov[i] += corr_vel[i];
+        }
+        f->dt_run_time += dt_imu;
+
+        if (f->dt_run_time >= 0.005) {
+            f->dt_run_time = 0.0;
+            f->flag_div += 1.0;
+            if (f->flag_div >= 4.0)
+                f->flag_div = 0.0;
+            if (fabs(f->flag_div - 1.0) < 1e-7 || fabs(f->flag_div - 3.0) < 1e-7) {
+                covariance_predict(f->p, f->del_ang_cov, f->del_vel_cov, f->q,
+                                   f->dt_cov, motionless_flag, prm->amode, prm);
+                memset(f->del_ang_cov, 0, sizeof f->del_ang_cov);
+                memset(f->del_vel_cov, 0, sizeof f->del_vel_cov);
+                f->dt_cov = 0.0;
+            } else if (fabs(f->flag_div - 2.0) < 1e-7) {
+                const double mag_norm = sqrt(mag[0] * mag[0] + mag[1] * mag[1]
+                                             + mag[2] * mag[2]);
+                if (prm->mag_fuse_method == 2 && mag_norm > 0.0 && prm->amode == 9) {
+                    double r_mag, mag_hdg_gate;
+                    if (motionless_flag < 3) {
+                        if (f->mag_run_time < 2.0) {
+                            r_mag = 100.0;
+                            mag_hdg_gate = prm->mag_hdg_gate;
+                        } else {
+                            r_mag = 10.0 * prm->mag_hdg_error * prm->mag_hdg_error;
+                            mag_hdg_gate = prm->mag_hdg_gate;
+                        }
+                    } else {
+                        if (f->mag_run_time > 10.0) {
+                            double qa[4];
+                            align_heading(f->q, mag, prm->mag_decl_deg * (M_PI / 180.0), qa);
+                            init_covariance(prm, prm->amode, f->p);
+                            memcpy(f->q, qa, sizeof f->q);
+                        }
+                        f->mag_run_time = 0.0;
+                        r_mag = 0.3 * prm->mag_hdg_error * prm->mag_hdg_error;
+                        mag_hdg_gate = prm->mag_hdg_gate;
+                    }
+                    const double meas_dec = prm->mag_decl_deg * (M_PI / 180.0);
+                    double qo[4], vo[3];
+                    mag_heading_observation_fuse(f->q, f->v, f->p, mag, meas_dec,
+                                                 mag_hdg_gate, r_mag, qo, vo);
+                    memcpy(f->q, qo, sizeof f->q);
+                    memcpy(f->v, vo, sizeof f->v);
+                } else {
+                    f->mag_run_time = 0.0;
+                }
+            } else {
+                /* ZUPT */
+                const double v_abs = fabs(f->v[0]) + fabs(f->v[1]) + fabs(f->v[2]);
+                double obs_var, gate;
+                if (motionless_flag == 0) {
+                    obs_var = 10000.0;
+                    gate = prm->body_vel_gate * 0.0001;
+                } else if (motionless_flag == 1) {
+                    if (v_abs > 0.5) memset(f->v, 0, sizeof f->v);
+                    obs_var = 1.0;
+                    gate = prm->body_vel_gate;
+                } else if (motionless_flag == 2) {
+                    if (v_abs > 0.5) memset(f->v, 0, sizeof f->v);
+                    obs_var = 0.010000000000000002;
+                    gate = prm->body_vel_gate * 10.0;
+                } else {
+                    if (v_abs > 0.1) memset(f->v, 0, sizeof f->v);
+                    obs_var = 0.0001;
+                    gate = prm->body_vel_gate * 100.0;
+                }
+                double qo[4], vo[3];
+                velocity_observation_fuse(f->q, f->v, f->p, obs_var, gate, qo, vo);
+                memcpy(f->q, qo, sizeof f->q);
+                memcpy(f->v, vo, sizeof f->v);
+            }
+        }
+    }
+
+    memcpy(f->gyro_old, gyro_in, sizeof f->gyro_old);
+    if (motionless_flag > 0)
+        memset(f->position, 0, sizeof f->position);
+}
diff --git a/samples/native_samples/sle/ekf7_jacobian.c b/samples/native_samples/sle/ekf7_jacobian.c
new file mode 100644
index 000000000..597c6303d
--- /dev/null
+++ b/samples/native_samples/sle/ekf7_jacobian.c
@@ -0,0 +1,172 @@
+/* ekf7_jacobian.c — F7/Q7/磁航向梯度解析雅可比（对应 ../ekf7/jacobian.py）。
+ * 全部为逐项标量展开，便于与参考实现逐行核对。 */
+#include "ekf7.h"
+
+void ekf7_calc_f7(double dax, double day, double daz,
+                  double dvx, double dvy, double dvz,
+                  double q0, double q1, double q2, double q3, double f[7][7])
+{
+    const double n  = dvx * q0 * 2.0;
+    const double n2 = dvx * q1 * 2.0;
+    const double n3 = dvx * q2 * 2.0;
+    const double n4 = dvx * q3 * 2.0;
+    const double n5 = dvy * q0 * 2.0;
+    const double n6 = dvy * q1 * 2.0;
+    const double n7 = dvy * q2 * 2.0;
+    const double n8 = dvy * q3 * 2.0;
+    const double n9 = dvz * q0 * 2.0;
+    const double n10 = dvz * q1 * 2.0;
+    const double n11 = dvz * q2 * 2.0;
+    const double n12 = dvz * q3 * 2.0;
+    const double n13 = dax / 2.0;
+    const double n14 = day / 2.0;
+    const double n15 = daz / 2.0;
+    const double n16 = -n3;
+    const double n17 = -n8;
+    const double n18 = -n10;
+    const double n19 = -n13;
+    const double n20 = -n14;
+    const double n21 = -n15;
+    const double n22 = n2 + n7 + n12;
+    const double n23 = n6 + n9 + n16;
+    const double n24 = n4 + n5 + n18;
+    const double n25 = n + n11 + n17;
+
+    for (int i = 0; i < 7; i++)
+        for (int j = 0; j < 7; j++)
+            f[i][j] = 0.0;
+
+    f[0][0] = 1.0;  f[0][1] = n19; f[0][2] = n20; f[0][3] = n21;
+    f[1][0] = n13;  f[1][1] = 1.0;  f[1][2] = n15; f[1][3] = n20;
+    f[2][0] = n14;  f[2][1] = n21;  f[2][2] = 1.0;  f[2][3] = n13;
+    f[3][0] = n15;  f[3][1] = n14;  f[3][2] = n19;  f[3][3] = 1.0;
+    f[4][0] = n25;  f[4][1] = n22;  f[4][2] = n23;  f[4][3] = -n4 - n5 + n10;
+    f[4][4] = 1.0;
+    f[5][0] = n24;  f[5][1] = n3 - n6 - n9;  f[5][2] = n22; f[5][3] = n25;
+    f[5][5] = 1.0;
+    f[6][0] = n23;  f[6][1] = n24;  f[6][2] = -n + n8 - n11; f[6][3] = n22;
+    f[6][6] = 1.0;
+}
+
+void ekf7_calc_q7(double dax_var, double day_var, double daz_var,
+                  double dvx_var, double dvy_var, double dvz_var,
+                  double q0, double q1, double q2, double q3, double q[7][7])
+{
+    const double n = q0 * q0, n2 = q1 * q1, n3 = q2 * q2, n4 = q3 * q3;
+    const double n5 = q0 * q1 * 2.0, n6 = q0 * q2 * 2.0, n7 = q0 * q3 * 2.0;
+    const double n8 = q1 * q2 * 2.0, n9 = q1 * q3 * 2.0, n10 = q2 * q3 * 2.0;
+    const double n11 = dax_var * q0 * q1 / 4.0;
+    const double n12 = dax_var * q0 * q2 / 4.0;
+    const double n13 = dax_var * q0 * q3 / 4.0;
+    const double n14 = dax_var * q1 * q2 / 4.0;
+    const double n15 = dax_var * q1 * q3 / 4.0;
+    const double n16 = dax_var * q2 * q3 / 4.0;
+    const double n17 = day_var * q0 * q1 / 4.0;
+    const double n18 = day_var * q0 * q2 / 4.0;
+    const double n19 = day_var * q0 * q3 / 4.0;
+    const double n20 = day_var * q1 * q2 / 4.0;
+    const double n21 = day_var * q1 * q3 / 4.0;
+    const double n22 = day_var * q2 * q3 / 4.0;
+    const double n23 = daz_var * q0 * q1 / 4.0;
+    const double n24 = daz_var * q0 * q2 / 4.0;
+    const double n25 = daz_var * q0 * q3 / 4.0;
+    const double n26 = daz_var * q1 * q2 / 4.0;
+    const double n27 = daz_var * q1 * q3 / 4.0;
+    const double n28 = daz_var * q2 * q3 / 4.0;
+    const double n29 = -n8, n30 = -n9, n31 = -n10;
+    const double n32 = -n2, n33 = -n3, n34 = -n4;
+    const double n35 = -n11, n36 = -n12, n37 = -n15, n38 = -n16;
+    const double n39 = -n18, n40 = -n19, n41 = -n20, n42 = -n21;
+    const double n43 = -n23, n44 = -n25, n45 = -n26, n46 = -n28;
+    const double n47 = n5 + n10, n48 = n6 + n9, n49 = n7 + n8;
+    const double n50 = n5 + n31, n51 = n6 + n30, n52 = n7 + n29;
+    const double n53 = n + n4 + n32 + n33;
+    const double n54 = n + n3 + n32 + n34;
+    const double n55 = n + n2 + n33 + n34;
+    const double n56 = n17 + n38 + n43;
+    const double n57 = n24 + n36 + n42;
+    const double n58 = n13 + n40 + n45;
+    const double n59 = n14 + n41 + n44;
+    const double n60 = n27 + n37 + n39;
+    const double n61 = n22 + n35 + n46;
+    const double n62 = dvx_var * n49 * n51;
+    const double n63 = dvy_var * n47 * n52;
+    const double n64 = dvz_var * n48 * n50;
+    const double n65 = dvx_var * n49 * n55;
+    const double n66 = dvy_var * n47 * n54;
+    const double n67 = dvz_var * n48 * n53;
+    const double n68 = dvx_var * n51 * n55;
+    const double n69 = dvy_var * n52 * n54;
+    const double n70 = dvz_var * n50 * n53;
+    const double n71 = -n62, n72 = -n63, n73 = -n64;
+    const double n74 = -n68, n75 = -n69, n76 = -n70;
+    const double n77 = n73 + n65 + n75;
+    const double n78 = n71 + n66 + n76;
+    const double n79 = n72 + n67 + n74;
+
+    for (int i = 0; i < 7; i++)
+        for (int j = 0; j < 7; j++)
+            q[i][j] = 0.0;
+
+    q[0][0] = dax_var * n2 / 4.0 + day_var * n3 / 4.0 + daz_var * n4 / 4.0;
+    q[0][1] = n61;  q[0][2] = n60;  q[0][3] = n59;
+    q[1][0] = n61;
+    q[1][1] = dax_var * n / 4.0 + day_var * n4 / 4.0 + daz_var * n3 / 4.0;
+    q[1][2] = n58;  q[1][3] = n57;
+    q[2][0] = n60;  q[2][1] = n58;
+    q[2][2] = dax_var * n4 / 4.0 + day_var * n / 4.0 + daz_var * n2 / 4.0;
+    q[2][3] = n56;
+    q[3][0] = n59;  q[3][1] = n57;  q[3][2] = n56;
+    q[3][3] = dax_var * n3 / 4.0 + day_var * n2 / 4.0 + daz_var * n / 4.0;
+    q[4][4] = dvx_var * n55 * n55 + dvy_var * n52 * n52 + dvz_var * n48 * n48;
+    q[4][5] = n77;  q[4][6] = n79;
+    q[5][4] = n77;
+    q[5][5] = dvx_var * n49 * n49 + dvy_var * n54 * n54 + dvz_var * n50 * n50;
+    q[5][6] = n78;
+    q[6][4] = n79;  q[6][5] = n78;
+    q[6][6] = dvx_var * n51 * n51 + dvy_var * n47 * n47 + dvz_var * n53 * n53;
+}
+
+void ekf7_calc_h_hdgc(double mx, double my, double mz,
+                      double q0, double q1, double q2, double q3, double h[7])
+{
+    const double n = q0 * q0, n2 = q1 * q1, n3 = q2 * q2, n4 = q3 * q3;
+    const double n5 = mx * q0 * 2.0, n6 = mx * q1 * 2.0;
+    const double n7 = my * q0 * 2.0, n8 = mx * q2 * 2.0;
+    const double n9 = my * q1 * 2.0, n10 = mz * q0 * 2.0;
+    const double n11 = mx * q3 * 2.0, n12 = my * q2 * 2.0;
+    const double n13 = mz * q1 * 2.0, n14 = my * q3 * 2.0;
+    const double n15 = mz * q2 * 2.0, n16 = mz * q3 * 2.0;
+    const double n17 = q0 * q1 * 2.0, n18 = q0 * q2 * 2.0, n19 = q0 * q3 * 2.0;
+    const double n20 = q1 * q2 * 2.0, n21 = q1 * q3 * 2.0, n22 = q2 * q3 * 2.0;
+    const double n23 = -n8, n24 = -n13, n25 = -n14;
+    const double n26 = -n20, n27 = -n22;
+    const double n28 = -n2, n29 = -n3, n30 = -n4;
+    const double n31 = n18 + n21, n32 = n19 + n20;
+    const double n33 = n6 + n12 + n16;
+    const double n34 = n17 + n27;
+    const double n35 = n19 + n26;
+    const double n36 = mx * n32, n37 = mz * n31;
+    const double n38 = n9 + n10 + n23;
+    const double n39 = n7 + n11 + n24;
+    const double n40 = n5 + n15 + n25;
+    const double n41 = n + n3 + n28 + n30;
+    const double n42 = n + n2 + n29 + n30;
+    const double n43 = my * n35, n44 = mz * n34;
+    const double n45 = mx * n42, n46 = my * n41;
+    const double n47 = -n43, n48 = -n44;
+    const double n49 = n37 + n47 + n45;
+    const double n50 = n36 + n48 + n46;
+    const double n51 = n49 * n49;
+    const double n52 = 1.0 / n50;
+    const double n53 = n52 * n52;
+    const double n54 = n51 * n53;
+    const double n55 = n54 + 1.0;
+    const double n56 = 1.0 / n55;
+
+    h[0] = n56 * (n40 * n52 - n39 * n49 * n53);
+    h[1] = n56 * (n33 * n52 + n38 * n49 * n53);
+    h[2] = n56 * (n38 * n52 - n33 * n49 * n53);
+    h[3] = -n56 * (n39 * n52 + n40 * n49 * n53);
+    h[4] = 0.0; h[5] = 0.0; h[6] = 0.0;
+}
diff --git a/samples/native_samples/sle/ekf7_math.c b/samples/native_samples/sle/ekf7_math.c
new file mode 100644
index 000000000..d4d3f6a1e
--- /dev/null
+++ b/samples/native_samples/sle/ekf7_math.c
@@ -0,0 +1,96 @@
+/* ekf7_math.c — 四元数与基础数学（对应 ../ekf7/quaternion.py + math_utils.py） */
+#include <math.h>
+#include <string.h>
+
+#include "ekf7.h"
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+double ekf7_wrap_pi(double angle)
+{
+    angle = fmod(angle, 2.0 * M_PI);
+    if (angle > M_PI)
+        angle -= 2.0 * M_PI;
+    else if (angle < -M_PI)
+        angle += 2.0 * M_PI;
+    return angle;
+}
+
+void ekf7_kfilter_inplace(double *prev, const double *x, double k, int n)
+{
+    const double km1 = 1.0 - k;
+    for (int i = 0; i < n; i++)
+        prev[i] = prev[i] * km1 + x[i] * k;
+}
+
+void ekf7_quat_multiply(const double a[4], const double b[4], double out[4])
+{
+    const double w = a[0], x = a[1], y = a[2], z = a[3];
+    const double w2 = b[0], x2 = b[1], y2 = b[2], z2 = b[3];
+    out[0] = w * w2 - x * x2 - y * y2 - z * z2;
+    out[1] = w * x2 + x * w2 + y * z2 - z * y2;
+    out[2] = w * y2 - x * z2 + y * w2 + z * x2;
+    out[3] = w * z2 + x * y2 - y * x2 + z * w2;
+}
+
+void ekf7_quat_normalized(const double q[4], double out[4])
+{
+    const double n = sqrt(q[0] * q[0] + q[1] * q[1] + q[2] * q[2] + q[3] * q[3]);
+    if (n < 1e-12) {
+        out[0] = 1.0; out[1] = out[2] = out[3] = 0.0;
+        return;
+    }
+    const double inv = 1.0 / n;
+    for (int i = 0; i < 4; i++)
+        out[i] = q[i] * inv;
+}
+
+void ekf7_quat_to_dcm(const double q[4], double r[9]) /* 行主序，体->导航 */
+{
+    const double w = q[0], x = q[1], y = q[2], z = q[3];
+    const double w2 = w * w, x2 = x * x, y2 = y * y, z2 = z * z;
+    const double xy = x * y, xz = x * z, yz = y * z;
+    const double wx = w * x, wy = w * y, wz = w * z;
+    r[0] = w2 + x2 - y2 - z2;  r[1] = 2.0 * (xy - wz);  r[2] = 2.0 * (xz + wy);
+    r[3] = 2.0 * (xy + wz);    r[4] = w2 - x2 + y2 - z2;r[5] = 2.0 * (yz - wx);
+    r[6] = 2.0 * (xz - wy);    r[7] = 2.0 * (yz + wx);  r[8] = w2 - x2 - y2 + z2;
+}
+
+void ekf7_quat_from_rv(const double rv[3], double q[4])
+{
+    const double n2 = rv[0] * rv[0] + rv[1] * rv[1] + rv[2] * rv[2];
+    double w, s;
+    if (n2 < 1e-8) {
+        w = 1.0 - n2 * (0.125 - n2 / 384.0);
+        s = 0.5 - n2 * (1.0 / 48.0 - n2 / 3840.0);
+    } else {
+        const double n = sqrt(n2);
+        w = cos(n * 0.5);
+        s = sin(n * 0.5) / n;
+    }
+    q[0] = w; q[1] = s * rv[0]; q[2] = s * rv[1]; q[3] = s * rv[2];
+}
+
+void ekf7_quat_from_euler(double phi, double theta, double psi, double q[4])
+{
+    const double cr = cos(phi * 0.5), sr = sin(phi * 0.5);
+    const double cp = cos(theta * 0.5), sp = sin(theta * 0.5);
+    const double cy = cos(psi * 0.5), sy = sin(psi * 0.5);
+    q[0] = cr * cp * cy + sr * sp * sy;
+    q[1] = sr * cp * cy - cr * sp * sy;
+    q[2] = cr * sp * cy + sr * cp * sy;
+    q[3] = cr * cp * sy - sr * sp * cy;
+}
+
+void ekf7_quat_to_euler(const double q[4], double rpy[3])
+{
+    const double w = q[0], x = q[1], y = q[2], z = q[3];
+    double num = 2.0 * (x * z - w * y);
+    if (num < -1.0) num = -1.0;
+    if (num > 1.0) num = 1.0;
+    rpy[0] = atan2(2.0 * (y * z + w * x), w * w - x * x - y * y + z * z);
+    rpy[1] = -asin(num);
+    rpy[2] = atan2(2.0 * (x * y + w * z), w * w + x * x - y * y - z * z);
+}
diff --git a/samples/native_samples/sle/ekf7_motion.c b/samples/native_samples/sle/ekf7_motion.c
new file mode 100644
index 000000000..b8ad208f8
--- /dev/null
+++ b/samples/native_samples/sle/ekf7_motion.c
@@ -0,0 +1,155 @@
+/* ekf7_motion.c — 三级静止检测器与静止自标定
+ * （对应 ../ekf7/{motion,auto_calibration}.py） */
+#include <math.h>
+#include <string.h>
+
+#include "ekf7.h"
+
+int ekf7_motion_detect(const double acc_in[3], const double gyro_in[3],
+                       ekf7_motion_state *ml, const ekf7_params *p, double dt)
+{
+    int still = 0;
+    ml->imu_sum_time_abs += dt;
+    for (int i = 0; i < 3; i++) {
+        if (acc_in[i] > ml->acc_raw_max_abs[i]) ml->acc_raw_max_abs[i] = acc_in[i];
+        if (acc_in[i] < ml->acc_raw_min_abs[i]) ml->acc_raw_min_abs[i] = acc_in[i];
+        if (gyro_in[i] > ml->gyro_raw_max_abs[i]) ml->gyro_raw_max_abs[i] = gyro_in[i];
+        if (gyro_in[i] < ml->gyro_raw_min_abs[i]) ml->gyro_raw_min_abs[i] = gyro_in[i];
+    }
+    if (!(fabs(ml->gyro_raw_max_abs[0] - ml->gyro_raw_min_abs[0]) < 0.010471204188481676
+          && fabs(ml->gyro_raw_max_abs[1] - ml->gyro_raw_min_abs[1]) < 0.010471204188481676
+          && fabs(ml->gyro_raw_max_abs[2] - ml->gyro_raw_min_abs[2]) < 0.010471204188481676
+          && fabs(ml->acc_raw_max_abs[0] - ml->acc_raw_min_abs[0]) < 0.2
+          && fabs(ml->acc_raw_max_abs[1] - ml->acc_raw_min_abs[1]) < 0.2
+          && fabs(ml->acc_raw_max_abs[2] - ml->acc_raw_min_abs[2]) < 0.2)) {
+        ml->imu_sum_time_abs = 0.0;
+        memcpy(ml->acc_raw_max_abs, acc_in, sizeof ml->acc_raw_max_abs);
+        memcpy(ml->acc_raw_min_abs, acc_in, sizeof ml->acc_raw_min_abs);
+        memcpy(ml->gyro_raw_max_abs, gyro_in, sizeof ml->gyro_raw_max_abs);
+        memcpy(ml->gyro_raw_min_abs, gyro_in, sizeof ml->gyro_raw_min_abs);
+    }
+    if (ml->imu_sum_time_abs >= 2.0) {
+        ml->imu_sum_time_abs = 2.0;
+        still = 1;
+    }
+    ml->yaw_sum_time += dt;
+    int yaw_still = 0;
+    if (gyro_in[2] > ml->yaw_max) ml->yaw_max = gyro_in[2];
+    if (gyro_in[2] < ml->yaw_min) ml->yaw_min = gyro_in[2];
+    if (!(fabs(ml->yaw_max - ml->yaw_min) < 5.0 / 573.0)) {
+        ml->yaw_sum_time = 0.0;
+        ml->yaw_max = gyro_in[2];
+        ml->yaw_min = gyro_in[2];
+    }
+    if (ml->yaw_sum_time >= 1.0) {
+        ml->yaw_sum_time = 1.0;
+        yaw_still = 1;
+    }
+    const double gyro_norm = sqrt(gyro_in[0] * gyro_in[0] + gyro_in[1] * gyro_in[1]
+                                  + gyro_in[2] * gyro_in[2]);
+    ml->gyro_ml_sum_time += dt;
+    int gyro_still = 0;
+    double gyro_thresh, time_thresh;
+    if (p->work_mode == 1) {
+        gyro_thresh = 50.0 / 573.0;
+        time_thresh = 0.5;
+    } else {
+        gyro_thresh = 0.02617801047120419;
+        time_thresh = 0.2;
+    }
+    if (gyro_norm > gyro_thresh)
+        ml->gyro_ml_sum_time = 0.0;
+    if (ml->gyro_ml_sum_time >= time_thresh) {
+        ml->gyro_ml_sum_time = time_thresh;
+        gyro_still = 1;
+    }
+    int flag;
+    if (still == 1) flag = 4;
+    else if (yaw_still == 1) flag = 2;
+    else if (gyro_still == 1) flag = 1;
+    else flag = 0;
+    ml->motionless_flag_out = flag;
+    return flag;
+}
+
+void ekf7_autocal_run(const double acc_in[3], const double gyro_in[3],
+                      ekf7_autocal_state *st, const ekf7_params *p, double dt,
+                      ekf7_autocal_result *out)
+{
+    const int n = (int)(p->fs * (double)p->ipack_mean);
+    memset(out, 0, sizeof *out);
+    out->imu_r[0] = out->imu_r[4] = out->imu_r[8] = 1.0;
+
+    st->imu_sum_time_abs += dt;
+    int still = 0;
+    for (int i = 0; i < 3; i++) {
+        if (acc_in[i] > st->acc_raw_max_abs[i]) st->acc_raw_max_abs[i] = acc_in[i];
+        if (acc_in[i] < st->acc_raw_min_abs[i]) st->acc_raw_min_abs[i] = acc_in[i];
+        if (gyro_in[i] > st->gyro_raw_max_abs[i]) st->gyro_raw_max_abs[i] = gyro_in[i];
+        if (gyro_in[i] < st->gyro_raw_min_abs[i]) st->gyro_raw_min_abs[i] = gyro_in[i];
+    }
+    if (!(fabs(st->gyro_raw_max_abs[0] - st->gyro_raw_min_abs[0]) < p->auto_cal_gyro_max_min
+          && fabs(st->gyro_raw_max_abs[1] - st->gyro_raw_min_abs[1]) < p->auto_cal_gyro_max_min
+          && fabs(st->gyro_raw_max_abs[2] - st->gyro_raw_min_abs[2]) < p->auto_cal_gyro_max_min
+          && fabs(st->acc_raw_max_abs[0] - st->acc_raw_min_abs[0]) < p->auto_cal_acc_max_min * 2.0
+          && fabs(st->acc_raw_max_abs[1] - st->acc_raw_min_abs[1]) < p->auto_cal_acc_max_min * 2.0
+          && fabs(st->acc_raw_max_abs[2] - st->acc_raw_min_abs[2]) < p->auto_cal_acc_max_min * 2.0)) {
+        st->imu_sum_time_abs = 0.0;
+        memcpy(st->acc_raw_max_abs, acc_in, sizeof st->acc_raw_max_abs);
+        memcpy(st->acc_raw_min_abs, acc_in, sizeof st->acc_raw_min_abs);
+        memcpy(st->gyro_raw_max_abs, gyro_in, sizeof st->gyro_raw_max_abs);
+        memcpy(st->gyro_raw_min_abs, gyro_in, sizeof st->gyro_raw_min_abs);
+    }
+    if (st->imu_sum_time_abs >= 2.0) {
+        st->imu_sum_time_abs = 2.0;
+        still = 1;
+    }
+    if (still == 1) {
+        st->motionless_cnt += 1.0;
+        const double n3 = (double)n * 0.5;
+        if (st->motionless_cnt < n3 * 1.0) {
+            memset(st->acc_in_sum1, 0, sizeof st->acc_in_sum1);
+            memset(st->gyro_in_sum1, 0, sizeof st->gyro_in_sum1);
+            st->imu_in_cnt1 = 0.0;
+        } else if (st->motionless_cnt < n3 * 2.0) {
+            for (int i = 0; i < 3; i++) {
+                st->acc_in_sum1[i] += acc_in[i];
+                st->gyro_in_sum1[i] += gyro_in[i];
+            }
+            st->imu_in_cnt1 += 1.0;
+        } else if (!(st->motionless_cnt < n3 * 3.0)) {
+            for (int i = 0; i < 3; i++)
+                out->gyro_bias[i] = st->gyro_in_sum1[i] / st->imu_in_cnt1;
+            double mean_acc[3];
+            for (int i = 0; i < 3; i++)
+                mean_acc[i] = st->acc_in_sum1[i] / st->imu_in_cnt1;
+            /* align_tilt：与 ekf7_filter.c 内部实现一致，此处内联展开 */
+            double q[4] = { 1.0, 0.0, 0.0, 0.0 };
+            {
+                const double ax = mean_acc[0], ay = mean_acc[1], az = mean_acc[2];
+                const double norm = sqrt(ax * ax + ay * ay + az * az);
+                if (norm > 5.0 && norm < 14.0) {
+                    const double horiz = sqrt(ax * ax + ay * ay);
+                    const double tilt = atan2(horiz, az);
+                    if (tilt > 0.001) {
+                        const double c[3] = { ay, -ax, 0.0 };
+                        const double cn = sqrt(c[0] * c[0] + c[1] * c[1]);
+                        if (cn > 1e-12) {
+                            const double s = sin(0.5 * tilt);
+                            q[0] = cos(0.5 * tilt);
+                            q[1] = (c[0] / cn) * s;
+                            q[2] = (c[1] / cn) * s;
+                            q[3] = (c[2] / cn) * s;
+                        }
+                    }
+                }
+            }
+            ekf7_quat_to_dcm(q, out->imu_r);
+            st->motionless_cnt = 0.0;
+            st->run_flag = 1.0;
+            out->completed = true;
+        }
+    } else {
+        st->motionless_cnt = 0.0;
+    }
+}
diff --git a/samples/native_samples/sle/ekf7_pipeline.c b/samples/native_samples/sle/ekf7_pipeline.c
new file mode 100644
index 000000000..cdadb7e7d
--- /dev/null
+++ b/samples/native_samples/sle/ekf7_pipeline.c
@@ -0,0 +1,78 @@
+/* ekf7_pipeline.c — 端到端管线（对应 ../ekf7/pipeline.py）
+ * 输入一阶低通 -> (前 10s) 静止自标定 -> 静止检测 -> 滤波器步进 */
+#include <math.h>
+#include <string.h>
+
+#include "ekf7.h"
+
+void ekf7_pipeline_init(ekf7_pipeline *pl, double fs, int work_mode, int amode)
+{
+    memset(pl, 0, sizeof *pl);
+    pl->prm = ekf7_params_default();
+    pl->prm.fs = fs;
+    pl->prm.work_mode = work_mode;
+    pl->prm.amode = amode;
+    pl->dt = 1.0 / fs;
+    ekf7_filter_init(&pl->filt, &pl->prm);
+    pl->rotm_install[0] = pl->rotm_install[4] = pl->rotm_install[8] = 1.0;
+    pl->enable_autocal = true;
+}
+
+void ekf7_pipeline_calculate(ekf7_pipeline *pl, const double acc_raw[3],
+                             const double gyro_raw[3], const double mag_raw[3],
+                             ekf7_output *out)
+{
+    double acc[3], gyro[3], mag[3];
+    memcpy(acc, acc_raw, sizeof acc);
+    memcpy(gyro, gyro_raw, sizeof gyro);
+    if (mag_raw)
+        memcpy(mag, mag_raw, sizeof mag);
+    else
+        memset(mag, 0, sizeof mag);
+
+    if (!pl->filt_init) {
+        memcpy(pl->acc_filt, acc, sizeof pl->acc_filt);
+        memcpy(pl->gyro_filt, gyro, sizeof pl->gyro_filt);
+        pl->filt_init = true;
+    } else {
+        ekf7_kfilter_inplace(pl->acc_filt, acc, pl->prm.acc_filt_k, 3);
+        ekf7_kfilter_inplace(pl->gyro_filt, gyro, pl->prm.gyro_filt_k, 3);
+    }
+
+    double gyro_corr[3];
+    for (int i = 0; i < 3; i++)
+        gyro_corr[i] = pl->gyro_filt[i] - pl->gyro_bias[i];
+    double acc_in[3], gyro_in[3];
+    for (int i = 0; i < 3; i++) {
+        acc_in[i] = pl->rotm_install[3 * i] * pl->acc_filt[0]
+                  + pl->rotm_install[3 * i + 1] * pl->acc_filt[1]
+                  + pl->rotm_install[3 * i + 2] * pl->acc_filt[2];
+        gyro_in[i] = pl->rotm_install[3 * i] * gyro_corr[0]
+                   + pl->rotm_install[3 * i + 1] * gyro_corr[1]
+                   + pl->rotm_install[3 * i + 2] * gyro_corr[2];
+    }
+
+    const int cal_limit = (int)pl->prm.fs * 10;
+    if (pl->icount < cal_limit)
+        pl->icount++;
+    if (pl->enable_autocal && pl->icount < cal_limit) {
+        ekf7_autocal_result res;
+        ekf7_autocal_run(pl->acc_filt, pl->gyro_filt, &pl->cal, &pl->prm, pl->dt, &res);
+        if (res.completed) {
+            memcpy(pl->rotm_install, res.imu_r, sizeof pl->rotm_install);
+            memcpy(pl->gyro_bias, res.gyro_bias, sizeof pl->gyro_bias);
+            pl->enable_autocal = false;
+            ekf7_filter_reset(&pl->filt);
+        }
+    }
+
+    const int motionless_flag = ekf7_motion_detect(acc_in, gyro_in, &pl->ml,
+                                                   &pl->prm, pl->dt);
+    ekf7_filter_step(&pl->filt, acc_in, gyro_in, mag, pl->dt, motionless_flag);
+
+    memcpy(out->quat, pl->filt.q, sizeof out->quat);
+    ekf7_quat_to_euler(pl->filt.q, out->euler_rad);
+    memcpy(out->vel, pl->filt.v, sizeof out->vel);
+    memcpy(out->pos, pl->filt.position, sizeof out->pos);
+    out->motionless = motionless_flag;
+}
