+static void aim_demo_next(aim_mouse_pkt_t *pkt, uint32_t tick)
+{
+    (void)tick;
+    pkt->magic = 0xA5;
+    pkt->dx = 0;
+    pkt->dy = 0;
+    pkt->keys = 0;
+}
+
+// 连接参数：实测默认参数下 SLE 传输延迟 100~1700ms 随机抖动（包等连接事件窗口）。
+// 正确姿势（SET_DEFAULT 全局默认会破坏 PAIR，已踩坑回退）：
+//   ① 栈启用后仅做 preset ADD（mode_id=1, 10~20ms 间隔）
+//   ② 连接建立后调 bs_sle_set_connect_param(dev_id, 1)（ssf_connection.h:860 运行时 API）
+static void aim_preset_conn_params(void)
+{
+    bs_sle_opr_pre_set_conn_param_t opr = {0};
+    opr.type = BS_SLE_PRESET_OPR_TYPE_ADD;
+    opr.in_add_param.mode_id = 1;
+    opr.in_add_param.para.interval_min = 8;             // 10ms（单位1.25ms）
+    opr.in_add_param.para.interval_max = 16;            // 20ms
+    opr.in_add_param.para.max_latency = 0;
+    opr.in_add_param.para.supervision_timeout = 100;    // 1s（单位10ms）
+    errcode_t r = bs_sle_config(SLE_CONFIG_CONNECT_PRESET_PARAM, &opr, sizeof(opr));
+    printf("[AIM][FSM] conn param preset ADD: 0x%x (10-20ms)\n", r);
+}
+
+// ================= 自动连接状态机（产品形态：上电自动连 dongle，断线重连） =================
+// 前向原型（定义在本文件后方）
+errcode_t sle_demo_client_init(void);
+errcode_t sle_ssapc_find_all_service(uint16_t dev_id, uint8_t client_id, bool is_remote);
+// 状态流：栈启用(一次) → SSAP注册(一次) → PAIR(全零地址直连，无需先扫) → 等连接 → FIND → RUN。
+// 断线回 PAIR 态重试；FIND 结果由回调捕获 g_aim_write_handle。任务节拍 100Hz（10ms/拍）。
+static void aim_conn_fsm(bool *need_delay)
+{
+    static uint8_t st = 0;
+    static uint32_t wait = 0;
+    static bool stack_inited = false;
+    static bool g_aim_param_set_done = false;
+    static bool ssap_inited = false;
+    *need_delay = false;
+
+    switch (st) {
+        case 0: // 栈启用（一次）
+            if (!stack_inited) {
+                (void)at_sle_client_enable();
+                aim_preset_conn_params(); // 仅 ADD preset；连接后由 case4 调 set（SET_DEFAULT 会破坏 PAIR）
+                stack_inited = true;
+            }
+            wait = 300; // 等 3s 栈起
+            st = 1;
+            break;
+        case 1:
+            if (--wait == 0) {
+                if (!ssap_inited) {
+                    (void)sle_demo_client_init(); // 注册 client + 拉起本任务(幂等)
+                    ssap_inited = true;
+                }
+                st = 2;
+            }
+            break;
+        case 2: { // 发起配对（全零地址直连广播中的 dongle）
+            if (bt_sle_is_connected()) {
+                st = 4;
+                break;
+            }
+            sle_pair addr = {0};
+            (void)at_client_connect_to_peripheral(&addr);
+            wait = 1500; // 15s 超时
+            st = 3;
+            break;
+        }
+        case 3: // 等连接
+            if (bt_sle_is_connected()) {
+                printf("[AIM][FSM] connected\n");
+                st = 4;
+            } else if (--wait == 0) {
+                st = 2; // 超时重试
+            }
+            break;
+        case 4: // 已连接：压连接间隔 → 缺句柄则 FIND
+            if (!bt_sle_is_connected()) {
+                g_aim_write_handle = 0; // 断线：清句柄回配对态
+                g_aim_param_set_done = false;
+                st = 2;
+                break;
+            }
+            if (!g_aim_param_set_done) { // 连接后一次性压间隔（治传输抖动）
+                errcode_t pr = bs_sle_set_connect_param(g_client_device_id, 1);
+                printf("[AIM][FSM] set_connect_param: 0x%x\n", pr);
+                g_aim_param_set_done = true;
+            }
+            if (g_aim_write_handle == 0) {
+                (void)sle_ssapc_find_all_service(g_client_device_id, g_client_id, false);
+                wait = 300;
+                st = 5;
+            }
+            break;
+        case 5: // 等 FIND 回调捕获句柄
+            if (g_aim_write_handle != 0) {
+                printf("[AIM][FSM] run (handle=0x%04x)\n", g_aim_write_handle);
+                st = 4;
+            } else if (--wait == 0) {
+                st = 4; // 再触发一次 FIND
+            }
+            break;
+        default:
+            st = 0;
+            break;
+    }
+}
+
+// 待发位移（像素）：这一拍发不出去（退避中、写失败）就留到下一拍接着发，运动不丢。上限 = 单包能带的最大位移
+#define AIM_PKT_MAX_DELTA 127
+static int32_t g_aim_pend_x = 0;
+static int32_t g_aim_pend_y = 0;
+
+static void aim_pend_clamp(int32_t *v)
+{
+    if (*v > AIM_PKT_MAX_DELTA) {
+        *v = AIM_PKT_MAX_DELTA;
+    }
+    if (*v < -AIM_PKT_MAX_DELTA) {
+        *v = -AIM_PKT_MAX_DELTA;
+    }
+}
+
+// ================= 主循环诊断（AT+AIM 读结果，AT+AIMDBG=<mask> 运行时开关） =================
+// 2026-11-24 上板：连上 dongle 且空闲时，主循环每约 25 拍卡一次、每次约 600ms；同时 AT 任务全程 1.4ms 响应，
+// 说明系统没冻住，只是这个任务被挡住。为避免靠反复烧录找原因，这里记下每一步的耗时，并留出运行时开关逐项排除。
+// mask 位：0x1 不读按键；0x2 查连接改用回调置的标志（不调 bt_sle_is_connected）；0x4 不读 IMU；0x8 不跑连接状态机；
+//          0x10 空闲时也强制发包（验证"发包时循环是否变快"）。
+#define AIM_DBG_NO_BTN      0x1U
+#define AIM_DBG_CACHED_CONN 0x2U
+#define AIM_DBG_NO_IMU      0x4U
+#define AIM_DBG_NO_FSM      0x8U
+#define AIM_DBG_FORCE_TX    0x10U
+volatile uint32_t g_aim_dbg_mask = 0;
+volatile uint8_t g_aim_conn_flag = 0; // 由 sle_com.c 的连接状态回调置位/清零
+
+#define AIM_DBG_STEP_NUM 6
+#define AIM_DBG_STEP_FSM   0
+#define AIM_DBG_STEP_IMU   1
+#define AIM_DBG_STEP_CONN  2
+#define AIM_DBG_STEP_BTN   3
+#define AIM_DBG_STEP_WRITE 4
+#define AIM_DBG_STEP_STAT  5
+static const char *const g_aim_dbg_step_name[AIM_DBG_STEP_NUM] = { "fsm", "imu", "conn", "btn", "write", "stat" };
+static uint32_t g_aim_dbg_max_us[AIM_DBG_STEP_NUM];
+static uint64_t g_aim_dbg_sum_us[AIM_DBG_STEP_NUM];
+static uint32_t g_aim_dbg_cnt[AIM_DBG_STEP_NUM];
+static uint32_t g_aim_dbg_slow[AIM_DBG_STEP_NUM]; // 这一步耗时超过 20ms 的次数
+static uint32_t g_aim_dbg_iters;                  // 统计期内的拍数
+static uint32_t g_aim_dbg_gap[5]; // 相邻两拍唤醒间隔的分布：<=11, 12-50, 51-200, 201-500, >500 (ms)
+static uint32_t g_aim_dbg_gap_max_ms;
+static uint32_t g_aim_dbg_gap_excess_ms;  // 间隔超出 10ms 的总时间
+static uint32_t g_aim_dbg_slp_over_max_us; // osal_msleep 比要求的多睡的最长时间
+
+static inline uint32_t aim_dbg_now_us(void)
+{
+    return (uint32_t)uapi_tcxo_get_us();
+}
+
+static bool aim_dbg_on(uint32_t bit)
+{
+    return (g_aim_dbg_mask & bit) != 0;
+}
+
+// 记一次某步骤的耗时（t0_us 是进入这一步前的时刻）
+static void aim_dbg_record(uint32_t step, uint32_t t0_us)
+{
+    uint32_t d = aim_dbg_now_us() - t0_us;
+    if (d > g_aim_dbg_max_us[step]) {
+        g_aim_dbg_max_us[step] = d;
+    }
+    g_aim_dbg_sum_us[step] += d;
+    g_aim_dbg_cnt[step]++;
+    if (d > 20000) {
+        g_aim_dbg_slow[step]++;
+    }
+}
+
+static void aim_dbg_reset(void)
+{
+    for (uint32_t i = 0; i < AIM_DBG_STEP_NUM; i++) {
+        g_aim_dbg_max_us[i] = 0;
+        g_aim_dbg_sum_us[i] = 0;
+        g_aim_dbg_cnt[i] = 0;
+        g_aim_dbg_slow[i] = 0;
+    }
+    for (uint32_t i = 0; i < 5; i++) {
+        g_aim_dbg_gap[i] = 0;
+    }
+    g_aim_dbg_iters = 0;
+    g_aim_dbg_gap_max_ms = 0;
+    g_aim_dbg_gap_excess_ms = 0;
+    g_aim_dbg_slp_over_max_us = 0;
+}
+
+// AT+AIM：主循环每一步的最大/平均耗时、卡住的次数，以及唤醒间隔分布。读完清零
+at_ret_t at_aim_report(void)
+{
+    uint32_t iters = g_aim_dbg_iters;
+    printf("[AIM][DBG] iters=%u mask=0x%x conn_flag=%d handle=0x%x\n", iters, (unsigned)g_aim_dbg_mask,
+        (int)g_aim_conn_flag, (unsigned)g_aim_write_handle);
+    printf("[AIM][DBG] step    max_ms   avg_ms  n>20ms\n");
+    for (uint32_t i = 0; i < AIM_DBG_STEP_NUM; i++) {
+        uint32_t max_us = g_aim_dbg_max_us[i];
+        uint64_t sum_us = g_aim_dbg_sum_us[i];
+        uint32_t n = g_aim_dbg_cnt[i];
+        uint32_t avg_us = (n != 0) ? (uint32_t)(sum_us / n) : 0;
+        printf("[AIM][DBG] %-6s %4u.%03u  %4u.%03u  %u\n", g_aim_dbg_step_name[i], max_us / 1000, max_us % 1000,
+            avg_us / 1000, avg_us % 1000, g_aim_dbg_slow[i]);
+    }
+    printf("[AIM][DBG] wake gap ms: <=11:%u 12-50:%u 51-200:%u 201-500:%u >500:%u  max=%u  excess=%u\n",
+        g_aim_dbg_gap[0], g_aim_dbg_gap[1], g_aim_dbg_gap[2], g_aim_dbg_gap[3], g_aim_dbg_gap[4],
+        g_aim_dbg_gap_max_ms, g_aim_dbg_gap_excess_ms);
+    printf("[AIM][DBG] sleep overrun max %u ms\n", g_aim_dbg_slp_over_max_us / 1000);
+    aim_dbg_reset();
+    return AT_RET_OK;
+}
+
+// AT+AIMDBG=<mask>：运行时关掉主循环里的某一步，用来逐项排除（复位后恢复全开）
+at_ret_t at_aim_dbg_set(aim_dbg_args *args)
+{
+    g_aim_dbg_mask = args->mask;
+    printf("[AIM][DBG] mask=0x%x: no_btn=%d cached_conn=%d no_imu=%d no_fsm=%d force_tx=%d\n",
+        (unsigned)g_aim_dbg_mask, aim_dbg_on(AIM_DBG_NO_BTN) ? 1 : 0, aim_dbg_on(AIM_DBG_CACHED_CONN) ? 1 : 0,
+        aim_dbg_on(AIM_DBG_NO_IMU) ? 1 : 0, aim_dbg_on(AIM_DBG_NO_FSM) ? 1 : 0,
+        aim_dbg_on(AIM_DBG_FORCE_TX) ? 1 : 0);
+    return AT_RET_OK;
+}
+
+static int aim_demo_task(void *arg)
+{
+    uint32_t sent = 0;
+    uint32_t fail = 0;
+    uint32_t skipped = 0;
+    uint32_t imu_fail = 0;
+    uint32_t stat_div = 0;
+    (void)arg;
+    errcode_t imu_ret = aim_imu_init();
+    printf("[AIM] imu init: 0x%x\n", imu_ret);
+    aim_imu_config(); // 软复位+唤醒+量程/ODR
+    aim_btn_init();   // 左右键 GPIO（开机采开路电平，约 125ms；期间不要按按键）
+    aim_imu_report(); // 开机即读一次
+    ekf7_pipeline_init(&g_aim_ekf, AIM_EKF_FS, 1, 0); // work_mode=1（验证态一致），六轴
+    g_aim_ekf_init = true;
+    // 量程寄存器回读（判断 bank2 配置是否生效，决定刻度）
+    uint8_t gcfg = 0, acfg = 0;
+    aim_imu_switch_bank(2);
+    (void)aim_imu_read_regs(0x01, &gcfg, 1);  // GYRO_CONFIG_1
+    (void)aim_imu_read_regs(0x14, &acfg, 1);  // ACCEL_CONFIG
+    aim_imu_switch_bank(0);
+    printf("[AIM][IMU] gyro_cfg=0x%02X accel_cfg=0x%02X (FS bits: 0=±250/2g 2=±500/4g)\n", gcfg, acfg);
+    printf("[AIM] demo task ready (EKF dx/dy @%gHz, gain=%g px/deg, auto-connect)\n", AIM_EKF_FS, AIM_RATE_GAIN);
+    // 固定节拍：第 n 拍的采样时刻 = 起点 + n×10ms，到点就采样；读传感器、解码、发包、打印都不影响下一拍的时刻。
+    // 旧写法"干完活再睡 10ms"，周期其实是 10ms + 干活时间（实测约 11.8ms），还会随干活时间抖动。
+    uint32_t next_tick = (uint32_t)osal_get_jiffies();
+    uint32_t prev_tick = next_tick;
+    uint32_t loop_n = 0;   // 本统计周期的拍数（正常 100）
+    uint32_t gap_max = 0;  // 本统计周期相邻两拍的最大间隔 ms（正常 10）
+    uint32_t late_cnt = 0; // 本统计周期间隔超过 11ms 的拍数（正常 0）
+    while (1) {
+        next_tick += AIM_DEMO_TICK_MS;
+        uint32_t now_tick = (uint32_t)osal_get_jiffies();
+        uint32_t sleep_ms = 0;
+        uint32_t t_sleep = aim_dbg_now_us();
+        if ((int32_t)(next_tick - now_tick) > 0) {
+            sleep_ms = (uint32_t)(next_tick - now_tick);
+            osal_msleep(sleep_ms);
+        } else {
+            next_tick = now_tick; // 已经晚于计划时刻：从现在起重排，不连发补拍
+        }
+        uint32_t t_step = aim_dbg_now_us();
+        if (sleep_ms != 0) {
+            int32_t over = (int32_t)(t_step - t_sleep) - (int32_t)(sleep_ms * 1000);
+            if ((over > 0) && ((uint32_t)over > g_aim_dbg_slp_over_max_us)) {
+                g_aim_dbg_slp_over_max_us = (uint32_t)over;
+            }
+        }
+        now_tick = (uint32_t)osal_get_jiffies();
+        uint32_t gap = now_tick - prev_tick;
+        prev_tick = now_tick;
+        loop_n++;
+        if (gap > gap_max) {
+            gap_max = gap;
+        }
+        if (gap > (AIM_DEMO_TICK_MS + 1)) {
+            late_cnt++;
+        }
+        {
+            uint32_t bin = (gap <= 11) ? 0 : ((gap <= 50) ? 1 : ((gap <= 200) ? 2 : ((gap <= 500) ? 3 : 4)));
+            g_aim_dbg_gap[bin]++;
+            g_aim_dbg_iters++;
+            if (gap > g_aim_dbg_gap_max_ms) {
+                g_aim_dbg_gap_max_ms = gap;
+            }
+            if (gap > AIM_DEMO_TICK_MS) {
+                g_aim_dbg_gap_excess_ms += gap - AIM_DEMO_TICK_MS;
+            }
+        }
+        // 自动连接状态机（每拍推进）
+        bool dummy = false;
+        if (!aim_dbg_on(AIM_DBG_NO_FSM)) {
+            aim_conn_fsm(&dummy);
+        }
+        aim_dbg_record(AIM_DBG_STEP_FSM, t_step);
+        t_step = aim_dbg_now_us();
+        // 采样与解算无条件每拍跑：独立于 SLE 链路（调算法不被连接状态绑架）。
+        // 实时环的防卡死层（0002 补丁把驱动等待改回 100ms 有限值）：读失败静默一拍再试；
+        // 真实读 14B@400kHz 至少 ~340us，比这还快的"成功"= 驱动信号量被上一拍迟到的完成事件
+        // 提前放行、缓冲区是半截数据（只在发生过超时类错误后才可能出现），当失败丢弃
+        static uint8_t imu_quiet = 0;
+        int16_t dx_now = 0;
+        int16_t dy_now = 0;
+        if (imu_quiet != 0) {
+            imu_quiet--;
+        } else if (!aim_dbg_on(AIM_DBG_NO_IMU)) {
+            uint32_t t_imu = aim_dbg_now_us();
+            bool ok = aim_ekf_step(&dx_now, &dy_now);
+            if (ok && (aim_dbg_now_us() - t_imu < 250)) {
+                dx_now = 0;
+                dy_now = 0;
+                ok = false;
+            }
+            if (!ok) {
+                imu_fail++;
+                imu_quiet = 1;
+            }
+        }
+        aim_dbg_record(AIM_DBG_STEP_IMU, t_step);
+        t_step = aim_dbg_now_us();
+        bool connected = aim_dbg_on(AIM_DBG_CACHED_CONN) ? (g_aim_conn_flag != 0) : bt_sle_is_connected();
+        aim_dbg_record(AIM_DBG_STEP_CONN, t_step);
+        // 连接态动态优先级：28（配对档）↔ 6（抢占档），见 AIM_DEMO_PRIO 注释
+        {
+            static bool prio_high = false;
+            if (connected && !prio_high) {
+                if (osal_kthread_set_priority(g_aim_task, AIM_DEMO_PRIO_ACTIVE) == 0) {
+                    prio_high = true;
+                    printf("[AIM] prio -> %u (connected)\n", AIM_DEMO_PRIO_ACTIVE);
+                }
+            } else if (!connected && prio_high) {
+                osal_kthread_set_priority(g_aim_task, AIM_DEMO_PRIO);
+                prio_high = false;
+                printf("[AIM] prio -> %u (disconnected)\n", AIM_DEMO_PRIO);
+            }
+        }
+        t_step = aim_dbg_now_us();
+        // 本拍位移进"待发"：这一拍发不出去就留到下一拍接着发
+        g_aim_pend_x += dx_now;
+        g_aim_pend_y += dy_now;
+        aim_pend_clamp(&g_aim_pend_x);
+        aim_pend_clamp(&g_aim_pend_y);
+        if (++stat_div >= AIM_EKF_FS) { // 每 100 拍打印姿态与统计
+            stat_div = 0;
+            double rpy[3];
+            ekf7_filter_euler(&g_aim_ekf.filt, rpy);
+            uint8_t btn_l = aim_pin_level(AIM_BTN_L_PIN);
+            uint8_t btn_r = aim_pin_level(AIM_BTN_R_PIN);
+            uint8_t btn_m = aim_pin_level(AIM_BTN_M_PIN);
+            printf("[AIM] rpy=[%.1f %.1f %.1f]deg moved=%upx sent=%u fail=%u imu_fail=%u align=%.1f/%.0f conn=%d hdl=0x%x skip=%u loop n=%u maxgap=%ums late=%u gain=%d enc[A B SW]=%d%d%d open=%d%d%d irq=%u btn[L R M]=%d%d%d open=%d%d%d keys=%d%d%d\n",
+                rpy[0] / AIM_D2R, rpy[1] / AIM_D2R, rpy[2] / AIM_D2R,
