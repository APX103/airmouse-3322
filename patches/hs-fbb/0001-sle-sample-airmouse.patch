+                btn_l != g_aim_btn_open[0], btn_r != g_aim_btn_open[1], btn_m != g_aim_btn_open[2]);
+            loop_n = 0;
+            gap_max = 0;
+            late_cnt = 0;
+        }
+        aim_dbg_record(AIM_DBG_STEP_STAT, t_step);
+        t_step = aim_dbg_now_us();
+        if (!connected || g_aim_write_handle == 0) {
+            g_aim_pend_x = 0; // 未连接：待发位移丢掉，免得重连后光标跳一下
+            g_aim_pend_y = 0;
+            continue;
+        }
+        // 退避背压（无确认写模式）：连续失败=栈队列压力，停 20 拍（200ms）再试；期间的位移留在"待发"里不丢。
+        // 退避只挡位移包：按键沿（点击/松开）不等退避，点击延迟比位移积压更可感，写失败自然续期
