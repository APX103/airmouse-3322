+// ================= ICM20948 最小驱动（M1/M2 验证版） =================
+// J1901-11/12 = I2C0_SCL/SDA(MGPIO_4/5)，电平 SW1901-5 默认 OFF=3.3V；地址 0x68（AD0 悬空）。
+#define AIM_IMU_BUS   0
