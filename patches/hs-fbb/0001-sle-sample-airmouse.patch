+// 2 拍一致消抖（100Hz 下 20ms 窗）；返回 keys 位图。电平与开路电平相反 = 按下
+static uint8_t aim_btn_scan(void)
+{
+    static uint8_t prev_raw = 0xFF;
+    static uint8_t stable = 0;
+    uint8_t raw = 0;
+    if (aim_pin_level(AIM_BTN_L_PIN) != g_aim_btn_open[0]) { raw |= 0x01; }
+    if (aim_pin_level(AIM_BTN_R_PIN) != g_aim_btn_open[1]) { raw |= 0x02; }
