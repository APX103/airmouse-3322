+// ================= EKF 姿态解算 + 指针映射（M3） =================
+// quat-zupt-ekf C99 移植（work/quat-zupt-ekf/c，差分验证 1e-8）；输入单位 m/s² 与 rad/s。
+static ekf7_pipeline g_aim_ekf;
+static bool g_aim_ekf_init = false;
+static double g_aim_rpy_last[3] = {0};
+static uint32_t g_aim_moved_px = 0;
+#define AIM_EKF_FS        100.0                    // 采样率 Hz（与任务节拍一致，联动 AIM_DEMO_TICK_MS）
+#define AIM_RATE_GAIN     50.0                     // px/deg（用户指定 50）
+#define AIM_DEADBAND_DEG  0.03                     // 单拍姿态增量死区
+
+#define AIM_ACC_LSB_PER_G 16384.0                  // ±2g（配置寄存器未生效的默认量程，重力实测校准）
+#define AIM_GYRO_LSB_DPS  131.072                  // ±250dps 默认量程
+#define AIM_G                 9.80665
+#define AIM_D2R               (3.14159265358979 / 180.0)
+
+// 一拍：读 IMU→EKF→输出 dx,dy（返回 false = 传感器读失败）
+static bool aim_ekf_step(int16_t *dx_out, int16_t *dy_out)
+{
+    uint8_t raw[14] = {0};
+    *dx_out = 0;
+    *dy_out = 0;
+    if (aim_imu_read_regs(AIM_IMU_DATA_REG, raw, 14) != ERRCODE_SUCC) {
+        return false;
+    }
+    double acc[3], gyr[3];
+    for (int i = 0; i < 3; i++) {
+        int16_t a = (int16_t)((raw[i * 2] << 8) | raw[i * 2 + 1]);
+        int16_t g = (int16_t)((raw[6 + i * 2] << 8) | raw[7 + i * 2 + 1]);
+        acc[i] = (double)a / AIM_ACC_LSB_PER_G * AIM_G;          // → m/s²
+        gyr[i] = (double)g / AIM_GYRO_LSB_DPS * AIM_D2R;         // → rad/s
+    }
+    ekf7_output o;
+    ekf7_pipeline_calculate(&g_aim_ekf, acc, gyr, NULL, &o);     // 六轴模式
+    // 轴映射（2026-10-14 用户实测校正）：绕 Z 轴转(偏航) → dx，绕 X 轴转(横滚) → dy，两轴均反号。
+    // （上一版误用绕 Y 轴(pitch)作 dy 且符号相反——安装姿态下板子"左右摆"= 绕Z，"翻腕"= 绕X）
+    double dyaw = (o.euler_rad[2] - g_aim_rpy_last[2]) / AIM_D2R;   // 绕 Z，deg
+    double droll = (o.euler_rad[0] - g_aim_rpy_last[0]) / AIM_D2R;  // 绕 X，deg
+    for (int i = 0; i < 3; i++) {
+        g_aim_rpy_last[i] = o.euler_rad[i];
+    }
+    if (o.motionless) {
+        return true; // 静止冻结：不产生位移
+    }
+    if (fabs(dyaw) < AIM_DEADBAND_DEG) {
+        dyaw = 0;
+    }
+    if (fabs(droll) < AIM_DEADBAND_DEG) {
+        droll = 0;
+    }
+    double dx = -dyaw * AIM_RATE_GAIN;   // 水平：绕 Z（2026-10-14 实测定稿）
+    double dy = droll * AIM_RATE_GAIN;   // 翻腕：绕 X（实测再反号定稿）
+    if (dx > 127) { dx = 127; }
+    if (dx < -127) { dx = -127; }
+    if (dy > 127) { dy = 127; }
+    if (dy < -127) { dy = -127; }
+    *dx_out = (int16_t)dx;
+    *dy_out = (int16_t)dy;
+    g_aim_moved_px += (uint32_t)(fabs(dx) + fabs(dy));
+    return true;
+}
+static osal_task *g_aim_task = NULL;
+
+// 带自定义数据的 SSAP 写（复用 sample 的写参数语义）
+static errcode_t sle_ssapc_write_buf(uint16_t dev_id, uint8_t client_id, uint16_t handle,
+    const uint8_t *data, uint16_t len)
+{
+    bs_sle_ssapc_write_param_t param = {0};
+    param.handle = handle;
+    param.type = SLE_WRITE_PARAM_TYPE;
+    // 无确认写（write command）：即发即走，延迟从确认RTT(~110ms)降到空口调度级；
+    // 背压靠返回值（栈队列满→失败→上层退避）。确认事件积压问题也随之消失。
+    param.is_need_confirm = false;
+    param.data_len = len;
+    param.data = (uint8_t *)data;
+    return bs_sle_ssapc_write(dev_id, client_id, &param);
+}
+
+static void aim_demo_next(aim_mouse_pkt_t *pkt, uint32_t tick)
+{
+    (void)tick;
+    pkt->magic = 0xA5;
+    pkt->dx = 0;
+    pkt->dy = 0;
+    pkt->keys = 0;
+}
+
+// ================= 自动连接状态机（产品形态：上电自动连 dongle，断线重连） =================
+// 前向原型（定义在本文件后方）
+errcode_t sle_demo_client_init(void);
+errcode_t sle_ssapc_find_all_service(uint16_t dev_id, uint8_t client_id, bool is_remote);
+// 状态流：栈启用(一次) → SSAP注册(一次) → PAIR(全零地址直连，无需先扫) → 等连接 → FIND → RUN。
+// 断线回 PAIR 态重试；FIND 结果由回调捕获 g_aim_write_handle。任务节拍 100Hz（10ms/拍）。
+static void aim_conn_fsm(bool *need_delay)
+{
+    static uint8_t st = 0;
+    static uint32_t wait = 0;
+    static bool stack_inited = false;
+    static bool ssap_inited = false;
+    *need_delay = false;
+
+    switch (st) {
+        case 0: // 栈启用（一次）
+            if (!stack_inited) {
+                (void)at_sle_client_enable();
+                stack_inited = true;
+            }
+            wait = 300; // 等 3s 栈起
+            st = 1;
+            break;
+        case 1:
+            if (--wait == 0) {
+                if (!ssap_inited) {
+                    (void)sle_demo_client_init(); // 注册 client + 拉起本任务(幂等)
+                    ssap_inited = true;
+                }
+                st = 2;
+            }
+            break;
+        case 2: { // 发起配对（全零地址直连广播中的 dongle）
+            if (bt_sle_is_connected()) {
+                st = 4;
+                break;
+            }
+            sle_pair addr = {0};
+            (void)at_client_connect_to_peripheral(&addr);
+            wait = 1500; // 15s 超时
+            st = 3;
+            break;
+        }
+        case 3: // 等连接
+            if (bt_sle_is_connected()) {
+                printf("[AIM][FSM] connected\n");
+                st = 4;
+            } else if (--wait == 0) {
+                st = 2; // 超时重试
+            }
+            break;
+        case 4: // 已连接：缺句柄则 FIND
+            if (!bt_sle_is_connected()) {
+                g_aim_write_handle = 0; // 断线：清句柄回配对态
+                st = 2;
+                break;
+            }
+            if (g_aim_write_handle == 0) {
+                (void)sle_ssapc_find_all_service(g_client_device_id, g_client_id, false);
+                wait = 300;
+                st = 5;
+            }
+            break;
+        case 5: // 等 FIND 回调捕获句柄
+            if (g_aim_write_handle != 0) {
+                printf("[AIM][FSM] run (handle=0x%04x)\n", g_aim_write_handle);
+                st = 4;
+            } else if (--wait == 0) {
+                st = 4; // 再触发一次 FIND
+            }
+            break;
+        default:
+            st = 0;
+            break;
+    }
+}
+
+static int aim_demo_task(void *arg)
+{
+    uint32_t sent = 0;
+    uint32_t fail = 0;
+    uint32_t skipped = 0;
+    uint32_t imu_fail = 0;
+    uint32_t stat_div = 0;
+    (void)arg;
+    errcode_t imu_ret = aim_imu_init();
+    printf("[AIM] imu init: 0x%x\n", imu_ret);
+    aim_imu_config(); // 软复位+唤醒+量程/ODR
+    aim_imu_report(); // 开机即读一次
+    ekf7_pipeline_init(&g_aim_ekf, AIM_EKF_FS, 1, 0); // work_mode=1（验证态一致），六轴
+    g_aim_ekf_init = true;
+    // 量程寄存器回读（判断 bank2 配置是否生效，决定刻度）
+    uint8_t gcfg = 0, acfg = 0;
+    aim_imu_switch_bank(2);
+    (void)aim_imu_read_regs(0x01, &gcfg, 1);  // GYRO_CONFIG_1
+    (void)aim_imu_read_regs(0x14, &acfg, 1);  // ACCEL_CONFIG
+    aim_imu_switch_bank(0);
+    printf("[AIM][IMU] gyro_cfg=0x%02X accel_cfg=0x%02X (FS bits: 0=±250/2g 2=±500/4g)\n", gcfg, acfg);
+    printf("[AIM] demo task ready (EKF dx/dy @%gHz, gain=%g px/deg, auto-connect)\n", AIM_EKF_FS, AIM_RATE_GAIN);
+    while (1) {
+        osal_msleep(AIM_DEMO_TICK_MS);
+        // 自动连接状态机（每拍推进）
+        bool dummy = false;
+        aim_conn_fsm(&dummy);
+        // EKF 无条件每拍跑：姿态解算独立于 SLE 链路（调算法不被连接状态绑架）
+        int16_t dx_now = 0;
+        int16_t dy_now = 0;
+        if (!aim_ekf_step(&dx_now, &dy_now)) {
+            imu_fail++;
+        }
+        if (++stat_div >= AIM_EKF_FS) { // 每秒打印姿态与统计
+            stat_div = 0;
+            double rpy[3];
+            ekf7_filter_euler(&g_aim_ekf.filt, rpy);
+            printf("[AIM] rpy=[%.1f %.1f %.1f]deg moved=%upx sent=%u imu_fail=%u align=%.1f/%.0f conn=%d hdl=0x%x skip=%u\n",
+                rpy[0] / AIM_D2R, rpy[1] / AIM_D2R, rpy[2] / AIM_D2R,
+                g_aim_moved_px, sent, imu_fail,
+                g_aim_ekf.filt.init_max_time, g_aim_ekf.filt.flag_in,
+                (int)bt_sle_is_connected(), (unsigned)g_aim_write_handle, skipped);
+        }
+        if (!bt_sle_is_connected() || g_aim_write_handle == 0) {
+            continue; // 未连接/未发现服务时静默等待
+        }
+        // 退避背压（无确认写模式）：连续失败=栈队列压力，停 20 拍（200ms）再试
+        if (g_aim_backoff > 0) {
+            g_aim_backoff--;
+            skipped++;
+            continue;
+        }
+        // 发送：直接用本拍 EKF 输出（零位移不发）
+        aim_mouse_pkt_t pkt;
+        pkt.magic = 0xA5;
+        pkt.keys = 0;
+        pkt.dx = dx_now;
+        pkt.dy = dy_now;
+        if (pkt.dx == 0 && pkt.dy == 0) {
+            continue;
+        }
+        if (sle_ssapc_write_buf(g_client_device_id, g_client_id, g_aim_write_handle,
+            (const uint8_t *)&pkt, sizeof(pkt)) == ERRCODE_BT_SUCCESS) {
+            sent++;
+            g_aim_fail_streak = 0;
+        } else {
+            fail++;
+            if (++g_aim_fail_streak >= 8) { // 连续8败=队列满，退避
+                g_aim_backoff = 20;
+                g_aim_fail_streak = 0;
+            }
+        }
+        if ((sent + fail + skipped) % 500 == 0) {
+            printf("[AIM] stream: sent=%u fail=%u skip=%u bk=%u\n", sent, fail, skipped, g_aim_backoff);
+        }
+    }
+    return 0;
+}
+
+static void aim_demo_start(void)
+{
+    if (g_aim_task != NULL) {
+        return;
+    }
+    // 业务保活：投睡眠否决票，防止低功耗吞任务节拍/断链（AT+PM=0 会被栈复位冲掉）
+    errcode_t pm_ret = uapi_pm_add_sleep_veto_with_symmetry(PM_ID_NATIVE_SAMPLE);
+    printf("[AIM] sleep veto: %s (0x%x)\n", pm_ret == ERRCODE_SUCC ? "on" : "FAILED", pm_ret);
+    osal_kthread_init init = {
+        .handler = aim_demo_task,
+        .taskprio = AIM_DEMO_PRIO,
+        .stacksize = AIM_DEMO_STACK,
+        .taskname = "aim_demo",
+        .data = NULL,
+        .policy = OSAL_THREAD_POLICY_DEFAULT,
+    };
+    g_aim_task = osal_kthread_create_ext(&init);
+    printf("[AIM] demo task %s\n", g_aim_task != NULL ? "created" : "create FAILED");
+}
+
+// 开机自启入口（由 sle_com.c 的 at_diting_sle_example_cmd_register 调用——AT 框架初始化是 3322 的可靠开机钩子；
+// app_run 的 initcall 在 3322 OpenHarmony 基线不被驱动，勿用）
+void aim_demo_boot(void)
+{
+    aim_demo_start();
+}
