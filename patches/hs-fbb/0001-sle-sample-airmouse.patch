+        pkt.keys = aim_dbg_on(AIM_DBG_NO_BTN) ? 0 : aim_btn_scan();
+        aim_dbg_record(AIM_DBG_STEP_BTN, t_step);
+        t_step = aim_dbg_now_us();
+        pkt.dx = (int16_t)g_aim_pend_x;
+        pkt.dy = (int16_t)g_aim_pend_y;
+        static uint8_t s_prev_keys_sent = 0;
+        bool keys_changed = (pkt.keys != s_prev_keys_sent);
+        bool any_held = (pkt.keys != 0);
+        if (g_aim_backoff > 0) {
+            if (!keys_changed) {
+                g_aim_backoff--;
+                skipped++;
+                continue;
+            }
+        } else if (!aim_dbg_on(AIM_DBG_FORCE_TX) && pkt.dx == 0 && pkt.dy == 0 && !keys_changed && !any_held) {
+            continue; // 全静止：不发包
+        }
+        if (keys_changed) {
+            printf("[AIM][BTN] keys=0x%x\n", pkt.keys); // 按键沿：串口可见（调试期）
+        }
+        if (sle_ssapc_write_buf(g_client_device_id, g_client_id, g_aim_write_handle,
+            (const uint8_t *)&pkt, sizeof(pkt)) == ERRCODE_BT_SUCCESS) {
+            g_aim_pend_x -= pkt.dx; // 发出去了才从"待发"里扣掉
+            g_aim_pend_y -= pkt.dy;
+            if (keys_changed) {
+                s_prev_keys_sent = pkt.keys; // 发出去才记：写失败的按键沿下一拍还能重试，快速点按不丢
+            }
+            sent++;
+            g_aim_fail_streak = 0;
+        } else {
+            fail++;
+            if (++g_aim_fail_streak >= 8) { // 连续8败=队列满，退避
+                g_aim_backoff = 20;
+                g_aim_fail_streak = 0;
+            }
+        }
+        aim_dbg_record(AIM_DBG_STEP_WRITE, t_step);
+        if ((sent + fail + skipped) % 500 == 0) {
+            printf("[AIM] stream: sent=%u fail=%u skip=%u bk=%u\n", sent, fail, skipped, g_aim_backoff);
+        }
+    }
+    return 0;
+}
+
+static void aim_demo_start(void)
+{
+    if (g_aim_task != NULL) {
+        return;
+    }
+    // 业务保活：投睡眠否决票，防止低功耗吞任务节拍/断链（AT+PM=0 会被栈复位冲掉）
+    errcode_t pm_ret = uapi_pm_add_sleep_veto_with_symmetry(PM_ID_NATIVE_SAMPLE);
+    printf("[AIM] sleep veto: %s (0x%x)\n", pm_ret == ERRCODE_SUCC ? "on" : "FAILED", pm_ret);
+    osal_kthread_init init = {
+        .handler = aim_demo_task,
+        .taskprio = AIM_DEMO_PRIO,
+        .stacksize = AIM_DEMO_STACK,
+        .taskname = "aim_demo",
+        .data = NULL,
+        .policy = OSAL_THREAD_POLICY_DEFAULT,
+    };
+    g_aim_task = osal_kthread_create_ext(&init);
+    printf("[AIM] demo task %s\n", g_aim_task != NULL ? "created" : "create FAILED");
+    aim_enc_start(); // 编码器任务（边沿中断驱动，幂等）
+}
