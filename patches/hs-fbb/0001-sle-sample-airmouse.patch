+// ================= 旋转编码器：灵敏度旋钮（feat/encoder，Waveshare Rotation Sensor，20 脉冲/圈带按键） =================
+// 接线 = Waveshare 官方标准五线（2026-11-25 定稿，用户要求不动特殊接法）：
+//   SIA→J1902 第9脚(TX4)=S_AGPIO11，SIB→第8脚(CTS4)=S_AGPIO13，SW→第10脚(RTS4)=S_AGPIO14，
+//   VCC→PIN17(3.3V)，GND→PIN5(GND)。拨码 SW1901 全 OFF。
+// 为什么不用 DO/DI/CLK（原理图 U1801/ET5014 那组）：那组排针侧被转换器死钉在 0（实测内部上拉都拉不动，
+// 模块 10K 上拉也翻不动），开关闭合造不出跳变。UART4 组（U1804/UM3204QT）排针侧空闲高电平
+// （右键 RX4=S_AGPIO12 实测空脚读 1 佐证），模块闭合拉低 = 标准跳变，与官方文档行为一致。
+// 固件仍按"开机实测空脚电平"判闭合，极性自适应；三根线纯输入，接错不损坏。
+// 采样方式：A/B/SW 三根线挂双边沿 GPIO 中断，有边沿才唤醒任务读引脚（空闲时零唤醒）。
+#define AIM_ENC_A_PIN    S_AGPIO8    // RX3（第 13 脚；TX4 被板级驱动钉死在 0，实测弃用）
+#define AIM_ENC_B_PIN    S_AGPIO13   // CTS4（第 8 脚）
+#define AIM_ENC_SW_PIN   S_AGPIO14   // RTS4（第 10 脚）
+#define AIM_ENC_STACK    0x2000
+#define AIM_ENC_PRIO     5     // 数值小=优先级高；高于 aim_demo(6)，边沿来了立刻读引脚（不高于系统关键任务区 2~4）
+#define AIM_ENC_IRQ      0     // 2026-11-25 实测：AGPIO 边沿中断注册成功但永不触发（旋转时 irq=0、电平变化只能靠统计行轮询看到），退回 10ms 轮询；p5+10ms 占空约 0.1%，v8.1 动态优先级下无碍
+#define AIM_ENC_TRIG_BOTH_EDGES 0x3U // hal_gpio.h 的 GPIO_INTERRUPT_DEDGE = 上升沿(0x1) | 下降沿(0x2)
+#define AIM_ENC_POLL_MS  1     // 2026-11-25 定稿：手拧 EC11 边沿间隔仅几 ms，10ms 采样漏掉大部分边沿（用户 Pico 实录同款教训：中断丢一半、改密轮询）；LiteOS tick 1ms+补偿 → 实际约 2ms/500Hz，任务占空 <1%
+#define AIM_ENC_REST_MS  100   // 停在定位点（A、B 都断开）超过此时长，清掉漏采留下的半格计数
+#define AIM_ENC_STEPS_PER_DETENT 4  // 一格 = A/B 走完一个周期（4 次合法跳变）；若实测"两格才变一次"改成 2
+#define AIM_ENC_SW_DEBOUNCE_MS 20   // 按键消抖窗（ms）
+#define AIM_ENC_DIR_SIGN (+1)  // B 超前 A 记作"加"；实测顺时针反而减小时改成 (-1)
+#define AIM_ENC_GAIN_STEP 2    // 旋一格 ±2 px/deg
+#define AIM_GAIN_MIN      10   // px/deg
+#define AIM_GAIN_MAX      150
+#define AIM_GAIN_DEFAULT  42   // px/deg。旧版循环 11.8ms 一拍却按 10ms 积分，标称 50 的实际手感约等于现在的 42
+
+// 运行时灵敏度（px/deg，整数）：编码器任务写、aim_demo 任务读；32 位整数读写原子，无需加锁
+static volatile int g_aim_gain = AIM_GAIN_DEFAULT;
+static volatile uint8_t g_aim_enc_raw = 0; // 调试用：bit2=A bit1=B bit0=SW 的原始电平（1=高）
+static volatile uint8_t g_aim_enc_open_mask = 0; // 同三位：各脚的空脚电平（编码器任务开机采样）
+static volatile uint32_t g_aim_enc_irq_cnt = 0; // 收到的边沿中断个数（调试用）
+static osal_task *g_aim_enc_task = NULL;
+
+// 相状态 = (A<<1)|B，"1"=触点闭合（引脚读低）。B 超前 A 的方向为 00→01→11→10→00（每步 +1），反向 −1。
+// 查表下标 (prev<<2)|curr：同态 0；单步合法跳变 ±1；双位同变（漏采/毛刺）为 0，由调用方只对齐不计步。
+static const int8_t g_aim_enc_tab[16] = {
+     0,  1, -1,  0,   // prev 00
+    -1,  0,  0,  1,   // prev 01
+     1,  0,  0, -1,   // prev 10
+     0, -1,  1,  0,   // prev 11
+};
+
+static uint8_t aim_enc_read(void)
+{
+    uint8_t raw = 0;
+    if (uapi_gpio_get_val(AIM_ENC_A_PIN) != GPIO_LEVEL_LOW) { raw |= 0x04; }
+    if (uapi_gpio_get_val(AIM_ENC_B_PIN) != GPIO_LEVEL_LOW) { raw |= 0x02; }
+    if (uapi_gpio_get_val(AIM_ENC_SW_PIN) != GPIO_LEVEL_LOW) { raw |= 0x01; }
+    g_aim_enc_raw = raw;
+    return raw;
+}
+
+// 相状态 = (A闭合<<1)|B闭合，"闭合"= 电平与该脚的开路电平相反
+static uint8_t aim_enc_state(uint8_t raw)
+{
+    return (uint8_t)(((raw ^ g_aim_enc_open_mask) & 0x06) >> 1);
+}
+
+// 一格事件：up=1 增益加一格，up=-1 减一格；夹在 [AIM_GAIN_MIN, AIM_GAIN_MAX]
+static void aim_enc_detent(int up)
+{
+    int gain = g_aim_gain + up * AIM_ENC_DIR_SIGN * AIM_ENC_GAIN_STEP;
+    if (gain < AIM_GAIN_MIN) {
+        gain = AIM_GAIN_MIN;
+    }
+    if (gain > AIM_GAIN_MAX) {
+        gain = AIM_GAIN_MAX;
+    }
+    if (gain == g_aim_gain) {
+        return; // 已在端点
+    }
+    g_aim_gain = gain;
+    printf("[AIM][ENC] %s gain=%d px/deg\n", up > 0 ? "up" : "down", gain);
+}
+
+// 解码器状态（仅 aim_enc_feed 访问，即只在编码器任务里跑）
+static uint8_t g_aim_enc_stable;   // 当前认可的相状态
+static int g_aim_enc_acc;          // 步数累加，满 ±STEPS_PER_DETENT 触发一格
+static uint16_t g_aim_enc_rest_ms; // 在定位点停留的时长（ms）
+static uint8_t g_aim_enc_sw_last;  // 已确认的按键状态（1=按下）
+static uint8_t g_aim_enc_sw_cand;  // 候选电平已在计时（上一拍与这一拍都是这个"不同"的电平）
+static uint16_t g_aim_enc_sw_ms;   // 候选电平被观察到的时长（ms）
+static uint32_t g_aim_enc_last_ms; // 上一次喂解码器的时刻（ms）
+static uint32_t g_aim_enc_timeout_ms = 0; // 任务下一次醒来的超时（ms，0=没有待办，只等边沿）
+
+// 喂一次原始电平。dt_ms = 距上一次喂的时间：轮询时就是轮询周期；中断驱动时是"距上个边沿/超时"的实际间隔，
+// 中间没有采样，所以时长只从"连续两次看到同一候选电平"开始累计。副作用只有 aim_enc_detent 与 SW 复位。
+// 静态零值恰好是"停在定位点、按键松开"的空闲态，上电无需专门初始化。
+static void aim_enc_feed(uint8_t raw, uint32_t dt_ms)
+{
+    // ---- SW：与已确认状态不同的电平要持续 DEBOUNCE_MS 才算稳定（闭合 = 与空脚电平相反） ----
+    uint8_t sw = (uint8_t)((raw ^ g_aim_enc_open_mask) & 0x01);
+    if (sw == g_aim_enc_sw_last) {
+        g_aim_enc_sw_cand = 0;
+        g_aim_enc_sw_ms = 0;
+    } else {
+        if (g_aim_enc_sw_cand && (g_aim_enc_sw_ms < AIM_ENC_SW_DEBOUNCE_MS)) {
+            g_aim_enc_sw_ms = (dt_ms >= AIM_ENC_SW_DEBOUNCE_MS) ? AIM_ENC_SW_DEBOUNCE_MS
+                                                                : (uint16_t)(g_aim_enc_sw_ms + dt_ms);
+        }
+        g_aim_enc_sw_cand = 1;
+        if (g_aim_enc_sw_ms >= AIM_ENC_SW_DEBOUNCE_MS) {
+            g_aim_enc_sw_last = sw;
+            g_aim_enc_sw_cand = 0;
+            g_aim_enc_sw_ms = 0;
+            if (sw) {
+                g_aim_gain = AIM_GAIN_DEFAULT;
+                printf("[AIM][ENC] sw press: gain reset %d\n", AIM_GAIN_DEFAULT);
+            }
+        }
+    }
+
+    // ---- A/B：每次采样直接查表，不做"连续 N 次才认"的滤波 ----
+    // 采样式解码只要不漏相位就必然正确：每步 ±1 沿真实路径累加，触点抖动一去一回自动抵消，
+    // 单次毛刺也是成对出现。加了滤波反而会在手快时滤掉短相位，导致丢格（Mac 上仿真实测）。
+    // 中断驱动下每次跳变都会采样，漏相位只会来自"任务还没读引脚就又跳了一次"。
+    uint8_t cur = aim_enc_state(raw);
+    uint8_t changed = (uint8_t)(cur != g_aim_enc_stable);
+    if (changed) {
+        g_aim_enc_acc += g_aim_enc_tab[(g_aim_enc_stable << 2) | cur]; // 0 = 双位同变（漏相位）：只对齐不计步
+        if (g_aim_enc_acc >= AIM_ENC_STEPS_PER_DETENT) {
+            g_aim_enc_acc -= AIM_ENC_STEPS_PER_DETENT;
+            aim_enc_detent(1);
+        } else if (g_aim_enc_acc <= -AIM_ENC_STEPS_PER_DETENT) {
+            g_aim_enc_acc += AIM_ENC_STEPS_PER_DETENT;
+            aim_enc_detent(-1);
+        }
+        g_aim_enc_stable = cur;
+    }
+
+    // ---- 停在定位点（A、B 都断开）够久：清掉漏采留下的半格计数 ----
+    if (g_aim_enc_stable != 0) {
+        g_aim_enc_rest_ms = 0;
+    } else if (!changed) {
+        if (g_aim_enc_rest_ms < AIM_ENC_REST_MS) {
+            g_aim_enc_rest_ms = (dt_ms >= AIM_ENC_REST_MS) ? AIM_ENC_REST_MS : (uint16_t)(g_aim_enc_rest_ms + dt_ms);
+            if (g_aim_enc_rest_ms >= AIM_ENC_REST_MS) {
+                g_aim_enc_acc = 0;
+            }
+        }
+    } else {
+        g_aim_enc_rest_ms = 0; // 刚到定位点，从这一拍起计时
+    }
+}
+
+// 距下一个"到点要再看一眼"的时刻还有多少 ms：按键候选电平的消抖窗、定位点停留的清零窗；都没有就返回 0
+static uint32_t aim_enc_next_timeout_ms(void)
+{
+    uint32_t timeout = 0;
+    if (g_aim_enc_sw_cand && (g_aim_enc_sw_ms < AIM_ENC_SW_DEBOUNCE_MS)) {
+        timeout = AIM_ENC_SW_DEBOUNCE_MS - g_aim_enc_sw_ms;
+    }
+    if ((g_aim_enc_stable == 0) && (g_aim_enc_acc != 0) && (g_aim_enc_rest_ms < AIM_ENC_REST_MS)) {
+        uint32_t rest = AIM_ENC_REST_MS - g_aim_enc_rest_ms;
+        if ((timeout == 0) || (rest < timeout)) {
+            timeout = rest;
+        }
+    }
+    return timeout;
+}
+
+// 任务醒来后的全部工作：读引脚 -> 按实际间隔喂解码器 -> 算出下一次超时。now_ms 用单调毫秒数（系统节拍）。
+static uint32_t aim_enc_service(uint32_t now_ms)
+{
+    aim_enc_feed(aim_enc_read(), now_ms - g_aim_enc_last_ms);
+    g_aim_enc_last_ms = now_ms;
+    return aim_enc_next_timeout_ms();
+}
+
+// GPIO 中断回调（中断上下文）：只记数、只唤醒任务；读引脚、解码、打印都在任务里做
+static osal_semaphore g_aim_enc_sem;
+
+static void aim_enc_isr(pin_t pin, uintptr_t param)
+{
+    (void)pin;
+    (void)param;
+    g_aim_enc_irq_cnt++;
+    osal_sem_up(&g_aim_enc_sem);
+}
+
+static int aim_enc_task(void *arg)
+{
+    (void)arg;
+#if AIM_INPUT_DIAG
+    aim_input_diag(AIM_ENC_A_PIN, "SIA RX3 S_AGPIO8 J1902-13");
+    aim_input_diag(AIM_ENC_B_PIN, "SIB CTS4 S_AGPIO13 J1902-8");
+    aim_input_diag(AIM_ENC_SW_PIN, "SW  RTS4 S_AGPIO14 J1902-10");
+    aim_input_diag(AIM_BTN_L_PIN, "L   S_AGPIO20 A_20 J1902-14");
+    aim_input_diag(AIM_BTN_R_PIN, "R   S_AGPIO12 J1902-7");
+    aim_input_diag(AIM_BTN_M_PIN, "M   S_AGPIO17 onboard SW2102");
+#endif
+    aim_input_config(AIM_ENC_A_PIN);
+    aim_input_config(AIM_ENC_B_PIN);
+    aim_input_config(AIM_ENC_SW_PIN);
+    osal_msleep(5); // 等配置稳定
+    // 开机采样三根线的开路电平（这段时间不要转旋钮、不要按 SW）
+    uint32_t high_a = 0;
+    uint32_t high_b = 0;
+    uint32_t high_sw = 0;
+    uint32_t samples = 0;
+    for (uint32_t t = 0; t < AIM_INPUT_IDLE_MS; t += AIM_INPUT_SAMPLE_MS) {
+        high_a += aim_pin_level(AIM_ENC_A_PIN);
+        high_b += aim_pin_level(AIM_ENC_B_PIN);
+        high_sw += aim_pin_level(AIM_ENC_SW_PIN);
+        samples++;
+        osal_msleep(AIM_INPUT_SAMPLE_MS);
+    }
+    g_aim_enc_open_mask = (uint8_t)((aim_input_open_level(high_a, samples) << 2) |
+        (aim_input_open_level(high_b, samples) << 1) | aim_input_open_level(high_sw, samples));
+    uint8_t raw = aim_enc_read();
+    printf("[AIM][ENC] init raw[A B SW]=%d%d%d open[A B SW]=%d%d%d gain=%d (没接模块时 raw 恒等于 open；闭合=与 open 相反)\n",
+        (raw >> 2) & 1, (raw >> 1) & 1, raw & 1,
+        (g_aim_enc_open_mask >> 2) & 1, (g_aim_enc_open_mask >> 1) & 1, g_aim_enc_open_mask & 1, g_aim_gain);
+
+#if AIM_ENC_IRQ
+    // 三根线都挂双边沿中断：有跳变才醒。任何一步失败就整体退回轮询，不留"半中断半轮询"的状态
+    bool irq_ok = (osal_sem_init(&g_aim_enc_sem, 0) == OSAL_SUCCESS);
+    const pin_t enc_pins[3] = { AIM_ENC_A_PIN, AIM_ENC_B_PIN, AIM_ENC_SW_PIN };
+    for (uint32_t i = 0; irq_ok && (i < 3); i++) {
+        if (uapi_gpio_register_isr_func(enc_pins[i], AIM_ENC_TRIG_BOTH_EDGES, aim_enc_isr) != ERRCODE_SUCC) {
+            irq_ok = false;
+        }
+    }
+    if (!irq_ok) {
+        for (uint32_t i = 0; i < 3; i++) {
+            (void)uapi_gpio_unregister_isr_func(enc_pins[i]);
+        }
+    }
+    printf("[AIM][ENC] sample mode: %s\n", irq_ok ? "edge-irq (wake on A/B/SW edges)" : "poll (irq unavailable)");
+#else
+    const bool irq_ok = false;
+    printf("[AIM][ENC] sample mode: poll (AIM_ENC_IRQ=0)\n");
+#endif
+    g_aim_enc_timeout_ms = aim_enc_service((uint32_t)osal_get_jiffies());
+    while (1) {
+        if (!irq_ok) {
+            osal_msleep(AIM_ENC_POLL_MS);
+        } else if (g_aim_enc_timeout_ms != 0) {
+            (void)osal_sem_down_timeout(&g_aim_enc_sem, g_aim_enc_timeout_ms); // 到点，或被边沿提前唤醒
+        } else {
+            (void)osal_sem_down(&g_aim_enc_sem); // 只等边沿
+        }
+        g_aim_enc_timeout_ms = aim_enc_service((uint32_t)osal_get_jiffies());
+    }
+    return 0;
+}
+
+static void aim_enc_start(void)
+{
+    if (g_aim_enc_task != NULL) {
+        return;
+    }
+    osal_kthread_init init = {
+        .handler = aim_enc_task,
+        .taskprio = AIM_ENC_PRIO,
+        .stacksize = AIM_ENC_STACK,
+        .taskname = "aim_enc",
+        .data = NULL,
+        .policy = OSAL_THREAD_POLICY_DEFAULT,
+    };
+    g_aim_enc_task = osal_kthread_create_ext(&init);
+    printf("[AIM][ENC] task %s\n", g_aim_enc_task != NULL ? "created" : "create FAILED");
+}
+
+// ================= ICM20948 最小驱动（M1/M2 验证版） =================
+// J1901 第11/12脚(丝印 C0_C/C0_D) = I2C0_SCL/SDA(MGPIO_4/5)，电平 SW1901-5 默认 OFF=3.3V；地址 0x68（AD0 悬空）。
+#define AIM_IMU_BUS   0
+#define AIM_IMU_ADDR  0x68
+#define AIM_IMU_WHOAMI_REG 0x00 // bank0，期望 0xEA
+#define AIM_IMU_DATA_REG   0x2D // bank0 起 accel 6B + gyro 6B + temp 2B
+
+static bool g_aim_imu_ok = false;
+
+static errcode_t aim_imu_init(void)
+{
+    uapi_pin_set_mode(4, 0); // SCL=MGPIO_4 mode0（AT+STARTI2CMASTER=...,4,5,0,0 实测 succ）
+    uapi_pin_set_mode(5, 0); // SDA=MGPIO_5
+    return uapi_i2c_master_init(AIM_IMU_BUS, 400000, 0);
+}
+
+// 组合事务：写寄存器地址后读 len 字节
+static errcode_t aim_imu_read_regs(uint8_t reg, uint8_t *buf, uint16_t len)
+{
+    uint8_t addr = reg;
+    uint8_t dummy[1] = {0};
+    i2c_data_t d = {0};
+    d.send_buf = &addr;
+    d.send_len = 1;
+    d.receive_buf = buf;
+    d.receive_len = len;
+    (void)dummy;
+    return uapi_i2c_master_writeread(AIM_IMU_BUS, AIM_IMU_ADDR, &d);
+}
+
+// 纯写：寄寄存器
+static errcode_t aim_imu_write_reg(uint8_t reg, uint8_t val)
+{
+    uint8_t w[2] = {reg, val};
+    i2c_data_t d = {0};
+    d.send_buf = w;
+    d.send_len = 2;
+    d.receive_buf = NULL;
+    d.receive_len = 0;
+    return uapi_i2c_master_write(AIM_IMU_BUS, AIM_IMU_ADDR, &d);
+}
+
+#define AIM_IMU_BANK_SEL 0x7F
+static void aim_imu_switch_bank(uint8_t bank)
+{
+    (void)aim_imu_write_reg(AIM_IMU_BANK_SEL, bank);
+}
+
+// ICM20948 初始化：软复位→唤醒→六轴全开→量程/ODR（±4g / ±500dps / ~225Hz）
+static errcode_t aim_imu_config(void)
+{
+    aim_imu_switch_bank(0);
+    (void)aim_imu_write_reg(0x06, 0x80 | 0x41); // PWR_MGMT_1: DEVICE_RESET + SLEEP
+    osal_msleep(60);                             // 复位后等待
+    (void)aim_imu_write_reg(0x06, 0x01);        // PWR_MGMT_1: CLK_PLL，唤醒
+    osal_msleep(5);
+    (void)aim_imu_write_reg(0x07, 0x00);        // PWR_MGMT_2: 加计+陀螺全开
+    aim_imu_switch_bank(2);
+    (void)aim_imu_write_reg(0x01, 0x02);        // GYRO_CONFIG_1: ±500dps, DLPF on
+    (void)aim_imu_write_reg(0x00, 0x04);        // GYRO_SMPLRT_DIV: 1125/(4+1)=225Hz
+    (void)aim_imu_write_reg(0x14, 0x02);        // ACCEL_CONFIG: ±4g, DLPF on
+    (void)aim_imu_write_reg(0x10, 0x00);        // ACCEL_SMPLRT_DIV_1
+    (void)aim_imu_write_reg(0x11, 0x04);        // ACCEL_SMPLRT_DIV_2: 225Hz
+    aim_imu_switch_bank(0);
+    return ERRCODE_SUCC;
+}
+
+static void aim_imu_report(void)
+{
+    uint8_t who = 0;
+    uint8_t raw[14] = {0};
+    if (aim_imu_read_regs(AIM_IMU_WHOAMI_REG, &who, 1) != ERRCODE_SUCC) {
+        printf("[AIM][IMU] whoami read FAIL\n");
+        return;
+    }
+    if (aim_imu_read_regs(AIM_IMU_DATA_REG, raw, 14) != ERRCODE_SUCC) {
+        printf("[AIM][IMU] raw read FAIL\n");
+        return;
+    }
+    int16_t ax = (int16_t)((raw[0] << 8) | raw[1]);
+    int16_t ay = (int16_t)((raw[2] << 8) | raw[3]);
+    int16_t az = (int16_t)((raw[4] << 8) | raw[5]);
+    int16_t gx = (int16_t)((raw[6] << 8) | raw[7]);
+    int16_t gy = (int16_t)((raw[8] << 8) | raw[9]);
+    int16_t gz = (int16_t)((raw[10] << 8) | raw[11]);
+    printf("[AIM][IMU] whoami=0x%02X a[%d %d %d] g[%d %d %d]\n",
+        who, ax, ay, az, gx, gy, gz);
+    if (who == 0xEA) {
+        g_aim_imu_ok = true;
+    }
+}
+
+// ================= EKF 姿态解算 + 指针映射（M3） =================
+// quat-zupt-ekf C99 移植（work/quat-zupt-ekf/c，差分验证 1e-8）；输入单位 m/s² 与 rad/s。
+static ekf7_pipeline g_aim_ekf;
+static bool g_aim_ekf_init = false;
+static double g_aim_rpy_last[3] = {0};
+static uint32_t g_aim_moved_px = 0;
+#define AIM_EKF_FS        100.0                    // 采样率 Hz（与任务节拍一致，联动 AIM_DEMO_TICK_MS）
+#define AIM_RATE_GAIN     ((double)g_aim_gain)         // px/deg：运行时值（默认 AIM_GAIN_DEFAULT，编码器旋钮可调）
+#define AIM_DEADBAND_DEG  0.03                     // 单拍姿态增量死区
+
+#define AIM_ACC_LSB_PER_G 16384.0                  // ±2g（配置寄存器未生效的默认量程，重力实测校准）
+#define AIM_GYRO_LSB_DPS  131.072                  // ±250dps 默认量程
+#define AIM_G                 9.80665
+#define AIM_D2R               (3.14159265358979 / 180.0)
+
+// ================== 映射模式开关 ==================
+// 1 = 陀螺速率直出（exp/gyro-direct 分支）：gyro−零偏 → 轻滤波 → ×gain×dt，延迟 ~1ms。
+//     EKF 加计观测会把姿态往重力方向拉（快速转动时永远慢半拍），速率直出绕开整个姿态链。
+// 0 = EKF 姿态差分（stable 分支）：绝对姿态语义，供锚定/混合模式用。
+#define AIM_USE_GYRO_DIRECT 1
+
+#if AIM_USE_GYRO_DIRECT
+static double g_aim_gyro_bias_rad[3] = {0}; // 零偏估计（静止时 EMA 跟踪）
+static double g_aim_gyro_lpf[3] = {0};      // 轻滤波后的角速度（k=0.8, τ≈1ms @100Hz）
+static bool g_aim_gyro_lpf_init = false;
+#define AIM_STILL_DPS      1.0    // 静止判据：三轴总角速度低于此（°/s）不积分
+#define AIM_BIAS_EMA       0.02   // 静止时零偏 EMA 系数（缓慢跟踪温漂）
+#define AIM_GYRO_LPF_K     0.8    // 轻滤波系数（τ≈1.25ms @100Hz）
+#endif
+
+// 一拍真实经过的时间上限：更长的停顿（退避、卡顿）不折算成运动，免得光标跳一下
+#define AIM_DT_MAX_S      0.05
+
+// 亚像素累积：一拍的位移常常不到 1 像素，直接取整会把零头扔掉（慢速时每拍都是 0，光标不动）。
+// 零头留到下一拍一起算，慢速也能匀速出点，总位移准确
+static double g_aim_px_acc_x = 0;
+static double g_aim_px_acc_y = 0;
+
+// 一拍：读 IMU→(EKF|直出)→输出 dx,dy（返回 false = 传感器读失败）
+static bool aim_ekf_step(int16_t *dx_out, int16_t *dy_out)
+{
+    uint8_t raw[14] = {0};
+    *dx_out = 0;
+    *dy_out = 0;
+    // 位移按这一拍真实经过的时间积分。循环偶尔晚醒（调度、打印）时，这一拍走完它该走的距离；
+    // 旧写法固定按 1/100 秒算，循环一慢光标就缩水成"动一下、停一下"
+    static uint64_t last_us = 0;
+    uint64_t now_us = uapi_tcxo_get_us();
+    double dt = (last_us == 0) ? (1.0 / AIM_EKF_FS) : (double)(now_us - last_us) * 1e-6;
+    last_us = now_us;
+    if (dt > AIM_DT_MAX_S) {
+        dt = AIM_DT_MAX_S;
+    }
+    if (aim_imu_read_regs(AIM_IMU_DATA_REG, raw, 14) != ERRCODE_SUCC) {
+        return false;
+    }
+    double acc[3], gyr[3];
+    for (int i = 0; i < 3; i++) {
+        int16_t a = (int16_t)((raw[i * 2] << 8) | raw[i * 2 + 1]);
+        // 陀螺仪 XYZ 依次占 raw[6..11]。低字节下标曾写成 raw[7 + i * 2 + 1]（取到了下一个轴的高字节，
+        // Z 轴取到温度的高字节），从初次提交起就错：每个轴只有高 8 位有效，读数被粗化成约 2°/s 一档，
+        // 慢转时光标在 0 和 29°/s 之间跳。2026-11-24 由 Mac 端运动仿真（tools/motion_sim）查出
+        int16_t g = (int16_t)((raw[6 + i * 2] << 8) | raw[6 + i * 2 + 1]);
+        acc[i] = (double)a / AIM_ACC_LSB_PER_G * AIM_G;          // → m/s²
+        gyr[i] = (double)g / AIM_GYRO_LSB_DPS * AIM_D2R;         // → rad/s
+    }
+    double dx = 0;
+    double dy = 0;
+#if AIM_USE_GYRO_DIRECT
+    // ---- 速率直出：零偏补偿 → 轻滤波 → 静止门 ----
+    if (!g_aim_gyro_lpf_init) {
+        for (int i = 0; i < 3; i++) {
+            g_aim_gyro_lpf[i] = gyr[i];
+        }
+        g_aim_gyro_lpf_init = true;
+    }
+    double corr[3];
+    for (int i = 0; i < 3; i++) {
+        double c = gyr[i] - g_aim_gyro_bias_rad[i];
+        g_aim_gyro_lpf[i] += AIM_GYRO_LPF_K * (c - g_aim_gyro_lpf[i]);
+        corr[i] = g_aim_gyro_lpf[i];
+    }
+    double norm_dps = sqrt(corr[0] * corr[0] + corr[1] * corr[1] + corr[2] * corr[2]) / AIM_D2R;
+    if (norm_dps < AIM_STILL_DPS) {
+        // 静止：零偏 EMA 逐拍运行，输出归零。不要"持续 0.3s 才算静止"的保持窗——2026-11-24 上板实测，
+        // 桌面噪声尖峰会反复打断保持窗，EMA 永不运行、零偏永不收敛，残余漂移以 ~27px/s 持续流出。
+        // 真实动作停下后陀螺 100ms 内衰减到零偏水平，此时每一拍跟踪到的就是零偏本身，α=0.02 约 5s 收敛
+        for (int i = 0; i < 3; i++) {
+            g_aim_gyro_bias_rad[i] += AIM_BIAS_EMA * (gyr[i] - g_aim_gyro_bias_rad[i]);
+        }
+        // 低于静止判据的拍不积分。零头会跨拍累积，这里若照常积分，停下后的残余角速度
+        //（手抖、零偏）就会变成几个像素的可见漂移。旧版每拍取整把零头扔了，所以看不出这个问题
+        return true;
+    }
+    // 延迟分段测量打点：甩动(>150°/s)瞬间打印——对照甩动动作看 [SNAP] 出现延迟=传感器+固件段
+    static uint32_t snap_armed = 1;
+    if (snap_armed && norm_dps > 150.0) {
+        printf("[SNAP] %d dps\n", (int)norm_dps);
+        snap_armed = 0; // 单发：静止门重新充能后再武装
+    }
+    if (norm_dps < 10.0) {
+        snap_armed = 1;
+    }
+    {
+        double dps_z = corr[2] / AIM_D2R; // 绕 Z（deg/s）
+        double dps_x = corr[0] / AIM_D2R; // 绕 X（deg/s）
+        g_aim_px_acc_x += -dps_z * AIM_RATE_GAIN * dt; // 轴映射沿用实测定稿：绕Z→dx 反号
+        g_aim_px_acc_y += dps_x * AIM_RATE_GAIN * dt;  // 绕X→dy 正号
+        dx = (double)(int)g_aim_px_acc_x; // 只取整数像素，零头留在累加器里
+        dy = (double)(int)g_aim_px_acc_y;
+        g_aim_px_acc_x -= dx;
+        g_aim_px_acc_y -= dy;
+    }
+#else
+    ekf7_output o;
+    ekf7_pipeline_calculate(&g_aim_ekf, acc, gyr, NULL, &o);     // 六轴模式
+    // 轴映射（2026-10-14 用户实测校正）：绕 Z 轴转(偏航) → dx，绕 X 轴转(横滚) → dy，两轴均反号。
+    double dyaw = (o.euler_rad[2] - g_aim_rpy_last[2]) / AIM_D2R;   // 绕 Z，deg
+    double droll = (o.euler_rad[0] - g_aim_rpy_last[0]) / AIM_D2R;  // 绕 X，deg
+    for (int i = 0; i < 3; i++) {
+        g_aim_rpy_last[i] = o.euler_rad[i];
+    }
+    // 注意：不用 o.motionless 冻结输出（导航级判据的小幅迟滞问题，详见 motionless 注释）
+    if (fabs(dyaw) < AIM_DEADBAND_DEG) {
+        dyaw = 0;
+    }
+    if (fabs(droll) < AIM_DEADBAND_DEG) {
+        droll = 0;
+    }
+    dx = -dyaw * AIM_RATE_GAIN;
+    dy = droll * AIM_RATE_GAIN;
+#endif
+    if (dx > 127) { dx = 127; }
+    if (dx < -127) { dx = -127; }
+    if (dy > 127) { dy = 127; }
+    if (dy < -127) { dy = -127; }
+    *dx_out = (int16_t)dx;
+    *dy_out = (int16_t)dy;
+    g_aim_moved_px += (uint32_t)(fabs(dx) + fabs(dy));
+    return true;
+}
+static osal_task *g_aim_task = NULL;
+
+// 带自定义数据的 SSAP 写（复用 sample 的写参数语义）
+static errcode_t sle_ssapc_write_buf(uint16_t dev_id, uint8_t client_id, uint16_t handle,
+    const uint8_t *data, uint16_t len)
+{
+    bs_sle_ssapc_write_param_t param = {0};
+    param.handle = handle;
+    param.type = SLE_WRITE_PARAM_TYPE;
+    // 无确认写（write command）：即发即走，延迟从确认RTT(~110ms)降到空口调度级；
+    // 背压靠返回值（栈队列满→失败→上层退避）。确认事件积压问题也随之消失。
+    param.is_need_confirm = false;
+    param.data_len = len;
+    param.data = (uint8_t *)data;
+    return bs_sle_ssapc_write(dev_id, client_id, &param);
+}
