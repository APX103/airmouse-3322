index 57e6ed6..781a635 100644
--- a/src/application/samples/products/sle_uart/sle_uart.c
+++ b/src/application/samples/products/sle_uart/sle_uart.c
@@ -15,6 +15,10 @@
 #if defined(CONFIG_SAMPLE_ENABLE_SLE_UART_SERVER)
 #include "securec.h"
 #include "sle_uart_server.h"
+#include "gadget/f_hid.h"
+
+// usb_keyboard 样例注册的复合 HID 描述符索引（keyscan_init.c，已去 static）
+extern int g_usb_keyscan_hid_index;
 #include "sle_uart_server_adv.h"
 #include "sle_device_discovery.h"
 #include "sle_errcode.h"
@@ -54,10 +58,38 @@ static void ssaps_server_read_request_cbk(uint8_t server_id, uint16_t conn_id, s
 static void ssaps_server_write_request_cbk(uint8_t server_id, uint16_t conn_id, ssaps_req_write_cb_t *write_cb_para,
     errcode_t status)
 {
-    osal_printk("%s ssaps write request callback cbk server_id:0x%x, conn_id:0x%x, handle:0x%x, status:0x%x\r\n",
-        SLE_UART_SERVER_LOG, server_id, conn_id, write_cb_para->handle, status);
-    if ((write_cb_para->length > 0) && write_cb_para->value) {
-        uapi_uart_write(CONFIG_SLE_UART_BUS, (uint8_t *)write_cb_para->value, write_cb_para->length, 0);
+    // AirMouse M4：解析 3322 的鼠标包（0xA5 + int16 dx + int16 dy + keys）→ USB HID report。
+    // 借 usb_keyboard 样例的复合描述符（report_id=0x02 段即 boot mouse：3 buttons + X/Y/wheel），
+    // 索引共享 keyscan_init.c 的 g_usb_keyscan_hid_index（已去 static）。低频聚合统计打印保留。
+    (void)server_id;
+    (void)conn_id;
+    (void)status;
+    static uint32_t s_rx_cnt = 0;
+    static uint32_t s_hid_ok = 0;
+    if ((write_cb_para->length >= 6) && write_cb_para->value) {
+        const uint8_t *v = (const uint8_t *)write_cb_para->value;
+        if (v[0] == 0xA5) {
+            int16_t dx = (int16_t)((uint16_t)v[1] | ((uint16_t)v[2] << 8));
+            int16_t dy = (int16_t)((uint16_t)v[3] | ((uint16_t)v[4] << 8));
+            if (dx > 127) { dx = 127; }
+            if (dx < -127) { dx = -127; }
+            if (dy > 127) { dy = 127; }
+            if (dy < -127) { dy = -127; }
+            if (g_usb_keyscan_hid_index >= 0) {
+                uint8_t rpt[5] = {0x02, (uint8_t)(v[5] & 0x07), (uint8_t)(int8_t)dx,
+                                  (uint8_t)(int8_t)dy, 0};
+                int32_t hid_ret = (int32_t)fhid_send_data((uint8_t)g_usb_keyscan_hid_index, (char *)rpt, 5);
+                if (hid_ret >= 0) {
+                    s_hid_ok++;
+                }
+            }
+        }
+        if (s_rx_cnt % 100 == 0) {
+            osal_printk("%s rx#%u hid#%u last[%d %d]\r\n", SLE_UART_SERVER_LOG, s_rx_cnt, s_hid_ok,
+                (int16_t)((uint16_t)v[1] | ((uint16_t)v[2] << 8)),
+                (int16_t)((uint16_t)v[3] | ((uint16_t)v[4] << 8)));
+        }
+        s_rx_cnt++;
     }
 }
 
